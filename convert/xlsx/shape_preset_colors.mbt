///|
// DrawingML preset colors follow the upstream CSS color table (MIT licensed).
fn xlsx_shape_preset_color(value : String) -> UInt32? {
  let name = value.to_lower()
  let name = if name.has_prefix("dk") {
    "dark" + name[2:].to_owned()
  } else if name.has_prefix("lt") {
    "light" + name[2:].to_owned()
  } else if name.has_prefix("med") {
    "medium" + name[3:].to_owned()
  } else {
    name
  }
  match name {
    "aliceblue" => Some(0xf0f8ffU)
    "antiquewhite" => Some(0xfaebd7U)
    "aqua" => Some(0x00ffffU)
    "aquamarine" => Some(0x7fffd4U)
    "azure" => Some(0xf0ffffU)
    "beige" => Some(0xf5f5dcU)
    "bisque" => Some(0xffe4c4U)
    "black" => Some(0x000000U)
    "blanchedalmond" => Some(0xffebcdU)
    "blue" => Some(0x0000ffU)
    "blueviolet" => Some(0x8a2be2U)
    "brown" => Some(0xa52a2aU)
    "burlywood" => Some(0xdeb887U)
    "cadetblue" => Some(0x5f9ea0U)
    "chartreuse" => Some(0x7fff00U)
    "chocolate" => Some(0xd2691eU)
    "coral" => Some(0xff7f50U)
    "cornflowerblue" => Some(0x6495edU)
    "cornsilk" => Some(0xfff8dcU)
    "crimson" => Some(0xdc143cU)
    "cyan" => Some(0x00ffffU)
    "darkblue" => Some(0x00008bU)
    "darkcyan" => Some(0x008b8bU)
    "darkgoldenrod" => Some(0xb8860bU)
    "darkgray" => Some(0xa9a9a9U)
    "darkgrey" => Some(0xa9a9a9U)
    "darkgreen" => Some(0x006400U)
    "darkkhaki" => Some(0xbdb76bU)
