///|
fn xlsx_shape_linear_component(value : Int32) -> UInt32 {
  let mut low = 0
  let mut high = xlsx_shape_linear_thresholds.length()
  while low + 1 < high {
    let mid = (low + high) / 2
    if xlsx_shape_linear_thresholds[mid] <= value {
      low = mid
    } else {
      high = mid
    }
  }
  low.to_uint()
}

