///|
fn xlsx_shape_linear_fraction(value : Double) -> UInt32 {
  if value == 0.0 {
    return 0U
  }
  let bits = value.reinterpret_as_uint64()
  let mut low = 0
  let mut high = xlsx_shape_linear_double_thresholds.length()
  while low + 1 < high {
    let mid = (low + high) / 2
    if xlsx_shape_linear_double_thresholds[mid] <= bits {
      low = mid
    } else {
      high = mid
    }
  }
  low.to_uint()
}
