    0x000000ffU,
  )
  check_hsl_lum(
    0.68650263888888885, 0.47520000000000001, 0.55649000000000004, 0.070099999999999996,
    -7.5242100000000001, 0x000000ffU,
  )
  check_hsl_lum(
    0.68983564814814813, 0.59867000000000004, 0.88368000000000002, 0.14929000000000001,
    -7.4007399999999999, 0x000000ffU,
  )
  check_hsl_lum(
    0.69316865740740741, 0.72214, 0.21085999999999999, 0.22847999999999999, -7.2772699999999997,
    0x000000ffU,
  )
  check_hsl_lum(
    0.69650166666666669, 0.84560999999999997, 0.53805000000000003, 0.30767, -7.1538000000000004,
    0x000000ffU,
  )
  check_hsl_lum(
    0.69983467592592596, 0.96908000000000005, 0.86524000000000001, 0.38685999999999998,
    -7.0303300000000002, 0x000000ffU,
  )
  check_hsl_lum(
    0.70316768518518513, 0.092539999999999997, 0.19242000000000001, 0.46605000000000002,
    -6.90686, 0x000000ffU,
  )
}

///|
fn check_hsl_lum(
  hue : Double,
  sat : Double,
  lum : Double,
  mod : Double,
  off : Double,
  expected : UInt32,
) -> Unit raise {
  let color = xlsx_shape_hsl_rgb(hue, sat, lum)
  let color = {
    red: 1.0 - color.red,
    green: 1.0 - color.green,
    blue: 1.0 - color.blue,
  }
  let color = xlsx_shape_apply_lum(color, "lumMod", mod)
  let color = {
    red: 1.0 - color.red,
    green: 1.0 - color.green,
    blue: 1.0 - color.blue,
  }
  let color = xlsx_shape_apply_lum(color, "lumOff", off)
  assert_eq(xlsx_shape_pack_rgb(color, 255U), expected)
}
