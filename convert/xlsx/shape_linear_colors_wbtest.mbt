///|
// Boundaries generated by the Go converter; checking both sides covers the
// entire monotone 0..100000 input domain without platform-dependent pow.
test "linear RGB quantization matches every upstream transition" {
  let thresholds : Array[Int32] = [
    0, 16, 46, 76, 107, 137, 167, 198, 228, 258, 289, 319, 351, 385, 421, 459, 498,
    540, 583, 628, 676, 725, 776, 830, 885, 943, 1003, 1065, 1129, 1195, 1264, 1334,
    1408, 1483, 1560, 1640, 1723, 1807, 1894, 1984, 2076, 2170, 2267, 2366, 2467,
    2572, 2678, 2788, 2899, 3014, 3131, 3250, 3372, 3497, 3625, 3755, 3888, 4023,
    4161, 4302, 4446, 4593, 4742, 4894, 5049, 5207, 5367, 5531, 5697, 5866, 6038,
    6213, 6391, 6572, 6755, 6942, 7132, 7324, 7520, 7719, 7920, 8125, 8333, 8544,
    8758, 8975, 9195, 9418, 9645, 9874, 10107, 10343, 10582, 10824, 11070, 11318,
    11570, 11826, 12084, 12346, 12611, 12879, 13150, 13425, 13703, 13985, 14270,
    14558, 14849, 15144, 15443, 15744, 16050, 16358, 16670, 16986, 17304, 17627,
    17953, 18282, 18615, 18951, 19291, 19634, 19981, 20332, 20686, 21043, 21405,
    21769, 22138, 22510, 22885, 23265, 23647, 24034, 24424, 24818, 25216, 25617,
    26022, 26430, 26843, 27259, 27679, 28102, 28530, 28961, 29395, 29834, 30277,
    30723, 31173, 31627, 32085, 32546, 33011, 33481, 33954, 34431, 34912, 35397,
    35885, 36378, 36875, 37375, 37879, 38388, 38900, 39416, 39937, 40461, 40989,
    41521, 42058, 42598, 43142, 43691, 44243, 44799, 45360, 45924, 46493, 47066,
    47643, 48223, 48809, 49398, 49991, 50588, 51190, 51796, 52406, 53020, 53638,
    54260, 54887, 55518, 56153, 56792, 57435, 58083, 58735, 59391, 60051, 60716,
    61385, 62058, 62736, 63418, 64104, 64794, 65489, 66188, 66891, 67599, 68311,
    69028, 69749, 70474, 71203, 71937, 72676, 73419, 74166, 74917, 75673, 76434,
    77199, 77968, 78742, 79520, 80303, 81090, 81882, 82678, 83478, 84284, 85093,
    85907, 86726, 87549, 88377, 89210, 90046, 90888, 91734, 92585, 93440, 94300,
    95164, 96033, 96906, 97785, 98668, 99555,
  ]
  for expected, value in thresholds {
    assert_eq(xlsx_shape_linear_component(value), expected.to_uint())
    if value > 0 {
      assert_eq(
        xlsx_shape_linear_component(value - 1),
        (expected - 1).to_uint(),
      )
    }
  }
  assert_eq(xlsx_shape_linear_component(100000), 255U)
}
