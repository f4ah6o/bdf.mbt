  for (bits, expected) in cases {
    assert_eq(
      xlsx_shape_linear_fraction(bits.reinterpret_as_double()),
      expected,
    )
  }
  assert_eq(xlsx_shape_linear_fraction(-0.0), 0U)
  for i = 0; i <= 100000; i = i + 1 {
    assert_eq(
      xlsx_shape_linear_fraction(i.to_double() / 100000.0),
      xlsx_shape_linear_component(i),
    )
  }
}
