///|
fn pptx_scatter_top_fixture() -> Bytes raise {
  @base64.decode(""[:])
}

///|
fn pptx_scatter_bottom_fixture() -> Bytes raise {
  @base64.decode(""[:])
}

///|
fn pptx_scatter_label_y(fixture : () -> Bytes raise) -> Double raise {
  let result = convert(fixture())
  let split = @core.single_to_split(result.bdf)
  let manifest = @core.parse_manifest(@utf8.decode(split.manifest))
  let body_hash = pptx_body_layer(manifest).object
  let resources = @core.decode_object_resources(
    @core.open_single(result.bdf).part(body_hash),
  )
  let ys : Array[Double] = []
  for command in @render.compile_object(resources.object) {
    match command {
      @render.FillText(_, _, y, _) => ys.push(y)
      _ => ()
    }
  }
  if ys.is_empty() { 0.0 } else { ys[ys.length() - 1] }
}

///|
test "PPTX scatter labels honour top and bottom positions" {
  assert_true(pptx_scatter_label_y(pptx_scatter_bottom_fixture) > pptx_scatter_label_y(pptx_scatter_top_fixture))
}
