///|
fn pptx_legend_delete_fixture() -> Bytes raise {
  @base64.decode(""[:])
}

///|
test "PPTX legends can delete entries and overlay the plot" {
  let result = convert(pptx_legend_delete_fixture())
  let split = @core.single_to_split(result.bdf)
  let manifest = @core.parse_manifest(@utf8.decode(split.manifest))
  let body_hash = pptx_body_layer(manifest).object
  let resources = @core.decode_object_resources(
    @core.open_single(result.bdf).part(body_hash),
  )
  let mut swatches = 0
  for command in @render.compile_object(resources.object) {
    match command {
      @render.FillRect(_, _, width, height) =>
        if (width - 8.0).abs() < 0.01 && (height - 8.0).abs() < 0.01 {
          swatches += 1
        }
      _ => ()
    }
  }
  assert_eq(swatches, 0)
}
