      (
        "ppt/slideLayouts/slideLayout6.xml", "ppt/slideMasters/slideMaster1.xml",
        true, true,
      ),
      (
        "ppt/slideLayouts/slideLayout6.xml", "ppt/slideMasters/slideMaster1.xml",
