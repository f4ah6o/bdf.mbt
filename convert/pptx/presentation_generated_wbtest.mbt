    720.00000000000000,
    540.00000000000000,
    1L,
    [
      ("ppt/slides/slide1.xml", false),
      ("ppt/slides/slide2.xml", false),
      ("ppt/slides/slide3.xml", false),
      ("ppt/slides/slide4.xml", false),
