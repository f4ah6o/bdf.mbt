///|
fn pptx_chart_table_fixture() -> Bytes raise {
  @base64.decode(""[:])
}

///|
test "PPTX charts with c:dTable draw a data table" {
  let result = convert(pptx_chart_table_fixture())
  let split = @core.single_to_split(result.bdf)
  let manifest = @core.parse_manifest(@utf8.decode(split.manifest))
  let body_hash = pptx_body_layer(manifest).object
  let resources = @core.decode_object_resources(
    @core.open_single(result.bdf).part(body_hash),
  )
  let commands = @render.compile_object(resources.object)
  let text = StringBuilder()
  let mut rects = 0
  for command in commands {
    match command {
      @render.FillText(value, _, _, _) => text.write_string(value)
      @render.StrokeRect(_, _, _, _) => rects += 1
      _ => ()
    }
  }
  assert_true(text.to_string().contains("DATA TABLE"))
  assert_true(text.to_string().contains("123"))
  assert_true(rects > 1)
}
///|
fn pptx_chart_table_flags_fixture() -> Bytes raise {
  @base64.decode(""[:])
}

///|
test "PPTX data table show flags suppress values and borders" {
  let result = convert(pptx_chart_table_flags_fixture())
  let split = @core.single_to_split(result.bdf)
  let manifest = @core.parse_manifest(@utf8.decode(split.manifest))
  let body_hash = pptx_body_layer(manifest).object
  let resources = @core.decode_object_resources(
    @core.open_single(result.bdf).part(body_hash),
  )
  let commands = @render.compile_object(resources.object)
  let text = StringBuilder()
  let mut rects = 0
  for command in commands {
    match command {
      @render.FillText(value, _, _, _) => text.write_string(value)
      @render.StrokeRect(_, _, _, _) => rects += 1
      _ => ()
    }
  }
  assert_true(!text.to_string().contains("123"))
  assert_true(rects <= 1)
}

