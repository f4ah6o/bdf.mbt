///|
fn pptx_scatter_axis_fixture() -> Bytes raise {
  @base64.decode(""[:])
}

///|
fn pptx_radar_axis_fixture() -> Bytes raise {
  @base64.decode(""[:])
}

///|
fn pptx_chart_text(data : Bytes) -> String raise {
  let result = convert(data)
  let split = @core.single_to_split(result.bdf)
  let manifest = @core.parse_manifest(@utf8.decode(split.manifest))
  let body_hash = pptx_body_layer(manifest).object
  let resources = @core.decode_object_resources(
    @core.open_single(result.bdf).part(body_hash),
  )
  let text = StringBuilder()
  for command in @render.compile_object(resources.object) {
    match command {
      @render.FillText(value, _, _, _) => text.write_string(value)
      _ => ()
    }
  }
  text.to_string()
}

///|
test "PPTX scatter and radar charts draw axis titles" {
  let scatter = pptx_chart_text(pptx_scatter_axis_fixture())
  assert_true(scatter.contains("SXAXIS"))
  assert_true(scatter.contains("SYAXIS"))
  let radar = pptx_chart_text(pptx_radar_axis_fixture())
  assert_true(radar.contains("RXAXIS"))
  assert_true(radar.contains("RYAXIS"))
}
