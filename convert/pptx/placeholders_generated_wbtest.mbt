        ("title", Some("")),
        ("hdr", Some("01")),
        ("sldNum", Some("")),
        ("pic", None),
        ("ctrTitle", Some("2")),
      ],
      ("ctrTitle", None),
      7,
      2,
    ),
    (
      [
        ("ctrTitle", Some("1")),
        ("dt", Some("1")),
        ("body", Some("2")),
        ("title", Some("alpha")),
        ("ctrTitle", Some("0")),
      ],
      ("sldNum", Some("01")),
      -1,
      -1,
    ),
    (
      [("dt", None), ("ftr", Some("1")), ("body", None), ("", Some(""))],
      ("title", Some("alpha")),
      -1,
      -1,
    ),
    (
      [("body", Some("1")), ("title", Some("1")), ("obj", Some("0"))],
      ("sldNum", Some("2")),
      -1,
      -1,
    ),
    (
      [
        ("ftr", Some("0")),
        ("hdr", None),
        ("sldNum", Some("")),
        ("ftr", Some("alpha")),
        ("ctrTitle", Some("")),
      ],
      ("obj", Some("2")),
      -1,
      -1,
    ),
    (
      [
        ("obj", None),
        ("", Some("")),
        ("body", Some("1")),
        ("ctrTitle", Some("0")),
        ("ftr", Some("01")),
        ("obj", Some("alpha")),
        ("ftr", None),
      ],
      ("ctrTitle", Some("2")),
      3,
      -1,
    ),
    (
      [
        ("", Some("2")),
        ("ftr", Some("")),
        ("hdr", Some("")),
        ("sldNum", Some("2")),
        ("sldNum", Some("0")),
      ],
      ("ctrTitle", None),
      -1,
      -1,
    ),
    (
      [("ctrTitle", None), ("obj", Some("2")), ("ftr", None)],
      ("hdr", Some("0")),
      -1,
      -1,
    ),
    (
      [
        ("sldNum", None),
        ("chart", Some("alpha")),
        ("body", Some("01")),
        ("body", None),
        ("dt", None),
        ("chart", Some("")),
      ],
      ("body", None),
      2,
      2,
    ),
    (
      [("pic", Some("0")), ("", None), ("ctrTitle", Some("alpha"))],
      ("title", None),
      2,
      -1,
    ),
    ([], ("dt", Some("1")), -1, -1),
    (
      [("chart", Some("01")), ("ftr", None), ("body", Some("")), ("ftr", None)],
      ("obj", None),
      -1,
      2,
    ),
    (
      [
        ("title", Some("")),
        ("ftr", Some("0")),
        ("obj", Some("0")),
        ("ftr", Some("2")),
        ("obj", Some("2")),
        ("ctrTitle", None),
        ("obj", None),
      ],
      ("body", None),
      -1,
      -1,
    ),
    (
      [
        ("title", None),
        ("chart", None),
        ("sldNum", None),
        ("obj", Some("01")),
        ("obj", None),
        ("ftr", Some("alpha")),
        ("hdr", None),
        ("sldNum", Some("1")),
      ],
      ("sldNum", Some("alpha")),
      5,
      2,
    ),
    ([("obj", Some("1")), ("hdr", Some(""))], ("sldNum", None), -1, -1),
    ([], ("ftr", None), -1, -1),
    (
      [
        ("ctrTitle", None),
        ("", Some("2")),
        ("hdr", Some("2")),
        ("ftr", Some("alpha")),
        ("chart", None),
        ("pic", Some("1")),
      ],
      ("obj", Some("0")),
      -1,
      -1,
    ),
    ([], ("chart", Some("0")), -1, -1),
  ]
  for (entries, target, layout, master) in cases {
    let list = entries.map(fn(v) { PptxPlaceholder::{ kind: v.0, index: v.1, } })
    let ph = PptxPlaceholder::{ kind: target.0, index: target.1, }
    assert_eq(pptx_find_placeholder(list, ph, false), layout)
    assert_eq(pptx_find_placeholder(list, ph, true), master)
  }
}
