///|
fn pptx_bar_ctr_fixture() -> Bytes raise {
  @base64.decode(""[:])
}

///|
fn pptx_bar_out_fixture() -> Bytes raise {
  @base64.decode(""[:])
}

///|
fn pptx_first_text_y(fixture : () -> Bytes raise) -> Double raise {
  let result = convert(fixture())
  let split = @core.single_to_split(result.bdf)
  let manifest = @core.parse_manifest(@utf8.decode(split.manifest))
  let body_hash = pptx_body_layer(manifest).object
  let resources = @core.decode_object_resources(
    @core.open_single(result.bdf).part(body_hash),
  )
  for command in @render.compile_object(resources.object) {
    match command {
      @render.FillText(text, _, y, _) =>
        if text == "1" {
          return y
        }
      _ => ()
    }
  }
  0.0
}

///|
test "PPTX bar labels honour dLblPos" {
  assert_true(pptx_first_text_y(pptx_bar_ctr_fixture) != pptx_first_text_y(pptx_bar_out_fixture))
}
