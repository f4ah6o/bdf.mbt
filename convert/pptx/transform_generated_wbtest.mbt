  for (xml, expected) in cases {
    let actual = match pptx_transform(xml) {
      Some(xf) =>
        Some(
          (xf.x, xf.y, xf.width, xf.height, xf.rotation, xf.flip_h, xf.flip_v),
        )
      None => None
    }
    assert_eq(actual, expected, msg=xml)
