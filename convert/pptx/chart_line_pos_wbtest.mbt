///|
fn pptx_line_top_fixture() -> Bytes raise {
  @base64.decode(""[:])
}

///|
fn pptx_line_bottom_fixture() -> Bytes raise {
  @base64.decode(""[:])
}

///|
fn pptx_line_label_y(fixture : () -> Bytes raise) -> Double raise {
  let result = convert(fixture())
  let split = @core.single_to_split(result.bdf)
  let manifest = @core.parse_manifest(@utf8.decode(split.manifest))
  let body_hash = pptx_body_layer(manifest).object
  let resources = @core.decode_object_resources(
    @core.open_single(result.bdf).part(body_hash),
  )
  for command in @render.compile_object(resources.object) {
    match command {
      @render.FillText(text, _, y, _) =>
        if text == "1" {
          return y
        }
      _ => ()
    }
  }
  0.0
}

///|
test "PPTX line labels honour top and bottom positions" {
  assert_true(pptx_line_label_y(pptx_line_bottom_fixture) > pptx_line_label_y(pptx_line_top_fixture))
}
