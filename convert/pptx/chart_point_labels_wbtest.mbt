///|
fn pptx_radar_label_fixture() -> Bytes raise {
  @base64.decode(""[:])
}

///|
fn pptx_scatter_label_fixture() -> Bytes raise {
  @base64.decode(""[:])
}

///|
fn pptx_chart_fill_text(data : Bytes) -> String raise {
  let result = convert(data)
  let split = @core.single_to_split(result.bdf)
  let manifest = @core.parse_manifest(@utf8.decode(split.manifest))
  let body_hash = pptx_body_layer(manifest).object
  let resources = @core.decode_object_resources(
    @core.open_single(result.bdf).part(body_hash),
  )
  let text = StringBuilder()
  for command in @render.compile_object(resources.object) {
    match command {
      @render.FillText(value, _, _, _) => text.write_string(value)
      _ => ()
    }
  }
  text.to_string()
}

///|
test "PPTX radar and scatter charts show dLbls values" {
  assert_true(pptx_chart_fill_text(pptx_radar_label_fixture()).contains("123"))
  assert_true(pptx_chart_fill_text(pptx_scatter_label_fixture()).contains("123"))
}
