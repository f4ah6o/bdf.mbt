///|
fn pptx_radar_chart_fixture() -> Bytes raise {
  @base64.decode(""[:])
}

///|
test "PPTX radar charts draw spokes and series polygons" {
  let result = convert(pptx_radar_chart_fixture())
  let split = @core.single_to_split(result.bdf)
  let manifest = @core.parse_manifest(@utf8.decode(split.manifest))
  let body_hash = pptx_body_layer(manifest).object
  let resources = @core.decode_object_resources(
    @core.open_single(result.bdf).part(body_hash),
  )
  let commands = @render.compile_object(resources.object)
  let mut points = 0
  let mut strokes = 0
  let text = StringBuilder()
  for command in commands {
    match command {
      @render.FillRect(_, _, _, _) => points += 1
      @render.StrokePath(_) => strokes += 1
      @render.FillText(value, _, _, _) => text.write_string(value)
      _ => ()
    }
  }
  assert_true(points >= 3)
  assert_true(strokes > 0)
  assert_true(text.to_string().contains("ABC"))
}
///|
fn pptx_radar_table_fixture() -> Bytes raise {
  @base64.decode(""[:])
}

///|
test "PPTX radar charts draw a data table" {
  let result = convert(pptx_radar_table_fixture())
  let split = @core.single_to_split(result.bdf)
  let manifest = @core.parse_manifest(@utf8.decode(split.manifest))
  let body_hash = pptx_body_layer(manifest).object
  let resources = @core.decode_object_resources(
    @core.open_single(result.bdf).part(body_hash),
  );
  let text = StringBuilder()
  for command in @render.compile_object(resources.object) {
    match command {
      @render.FillText(value, _, _, _) => text.write_string(value)
      _ => ()
    }
  }
  assert_true(text.to_string().contains("123"))
}

