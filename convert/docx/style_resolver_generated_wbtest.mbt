}

///|
test "DOCX style resolver matches upstream Go 1" {
  check_docx_style(
    "<styles><docDefaults><pPrDefault><pPr><jc val=\"right\"/><spacing before=\"400\"/></pPr></pPrDefault><rPrDefault><rPr><rFonts asciiTheme=\"minorAscii\"/><sz val=\"24\"/><lang val=\"en-US\"/><b/></rPr></rPrDefault></docDefaults><style styleId=\"base\" type=\"paragraph\"><pPr><ind left=\"300\"/><jc val=\"center\"/></pPr><rPr><i/><sz val=\"30\"/></rPr></style><style styleId=\"p\" type=\"paragraph\" default=\"1\"><basedOn val=\"base\"/><pPr><spacing after=\"120\"/></pPr><rPr><b val=\"0\"/></rPr></style><style styleId=\"cbase\" type=\"character\"><rPr><b/><rFonts ascii=\"Styled\"/></rPr></style><style styleId=\"c\" type=\"character\" default=\"1\"><basedOn val=\"cbase\"/><rPr><i/><lang eastAsia=\"ja-JP\"/></rPr></style></styles>",
    "<pPr><pStyle val=\"unknown\"/><jc val=\"both\"/><ind hanging=\"240\"/></pPr>",
    "<rPr><b/><sz val=\"18\"/></rPr>",
    "p",
    (
      "both",
      15.000000000000000,
      0.0000000000000000,
      -12.000000000000000,
      20.000000000000000,
      6.0000000000000000,
      240.00000000000000,
      "auto",
      false,
      true,
      -1,
      [],
    ),
    {
      fonts: ["Styled", "Times New Roman", "", "Times New Roman"],
      themes: ["", "", "", ""],
      hint: "",
      toggles: 1,
      specified: 0,
      size: 9.0000000000000000,
      color: 255U,
      auto_color: true,
      shading: 0U,
      has_shading: false,
      underline_color: 0U,
      has_underline_color: false,
      highlight: "",
      underline: "none",
      vertical_align: "",
      position: 0.0000000000000000,
      spacing: 0.0000000000000000,
      scale: 1.0000000000000000,
      emphasis: "",
      languages: ["en-US", "ja-JP", ""],
      web_hidden: false,
      rtl: false,
      tcy: false,
      tcy_fit: false,
    },
  )
}

