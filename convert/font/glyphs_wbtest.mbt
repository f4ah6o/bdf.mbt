///|
test "Unicode character mappings and script tie order" {
  let data : Bytes = b"\x00\x01\x00\x00\x00\x02\x00\x20\x00\x01\x00\x00\x63\x6d\x61\x70\x00\x29\x03\x85\x00\x00\x00\x2c\x00\x00\x00\x60\x6d\x61\x78\x70\x00\x03\x00\x00\x00\x00\x00\x8c\x00\x00\x00\x06\x00\x00\x00\x02\x00\x03\x00\x01\x00\x00\x00\x14\x00\x03\x00\x0a\x00\x00\x00\x2c\x00\x04\x00\x18\x00\x00\x00\x02\x00\x02\x00\x00\x00\x00\xff\xff\x00\x00\xff\xff\x00\x01\x00\x00\x00\x0c\x00\x00\x00\x00\x00\x34\x00\x00\x00\x00\x00\x00\x00\x03\x00\x01\xe6\xc0\x00\x01\xe6\xc0\x00\x00\x00\x01\x00\x01\xf7\x01\x00\x01\xf7\x01\x00\x00\x00\x05\x00\x03\x23\xb0\x00\x03\x23\xb0\x00\x00\x00\x01\x00\x01\x00\x00\x00\x02\x00\x00"
  let face = load(data).faces()[0]
  let glyphs = face.specimen_glyphs()
  assert_eq(glyphs[0].label, "")
  assert_eq(glyphs[1].characters, [0x1e6c0, 0x323b0])
  assert_eq(glyphs[1].label, "U+1E6C0 +1")
  assert_eq(glyphs[1].alternative, "\u{1e6c0}")
  let counts = face.script_counts()
  assert_eq(counts[0].name, "Han")
  assert_eq(counts[1].name, "Tai_Yo")
  assert_true(script_name_compare("Oriya", "Grantha") > 0)
}
