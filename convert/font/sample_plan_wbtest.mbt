  let file = load(data)
  let plan = file.faces()[0].sample_plan("")
  assert_eq(plan.specimen, "Ωω")
  assert_eq(
    plan.waterfall,
    "Τάχιστη αλώπηξ βαφής ψημένη γη, δρασκελίζει υπέρ νωθρού κυνός.",
  )
  assert_eq(plan.lang, "el")
  assert_eq(plan.rtl, false)
  assert_eq(plan.scripts.length(), 4)
  assert_eq(
    plan.all(),
    "ΩωΤάχιστη αλώπηξ βαφής ψημένη γη, δρασκελίζει υπέρ νωθρού κυνός.ΑΒΓΔΕΖΗΘΙΚΛΜαβγδεζηθικλμThe quick brown fox jumps over the lazy dog.色は匂へど散りぬるを 我が世誰ぞ常ならむ いろはにほへとΤάχιστη αλώπηξ βαφής ψημένη γη, δρασκελίζει υπέρ νωθρού κυνός.نص حكيم له سر قاطع وذو شأن عظيم مكتوب على ثوب أخضر ومغلف بجلد أزرق",
  )
}
