///|
test "specimen paths flip font coordinates and reject unreadable glyphs" {
  let file = load(
    b"\x00\x01\x00\x00\x00\x04\x00\x40\x00\x02\x00\x00\x67\x6c\x79\x66\x00\x15\x36\x4d\x00\x00\x00\x4c\x00\x00\x00\x24\x68\x65\x61\x64\x00\x00\x03\xe8\x00\x00\x00\x70\x00\x00\x00\x36\x6c\x6f\x63\x61\x00\x12\x00\x1c\x00\x00\x00\xa8\x00\x00\x00\x08\x6d\x61\x78\x70\x00\x04\x00\x00\x00\x00\x00\xb0\x00\x00\x00\x06\x00\x01\x00\x00\x00\x00\x00\x0a\x00\x0a\x00\x01\x00\x00\x36\x36\x00\x0a\x00\x0a\xff\xff\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x07\xb0\x81\xc1\x00\x00\x00\x00\x00\x00\x03\xe8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x0a\x00\x12\x00\x12\x00\x01\x00\x00\x00\x03\x00\x00",
  )
  let outlines = file.faces()[0].outlines()
  let path = outlines.path(0).unwrap()
  assert_eq(path.verbs, b"\x00\x02\x02\x04")
  assert_eq(path.coordinates, [
    5.0, -5.0, 0.0, 0.0, 5.0, -5.0, 10.0, -10.0, 5.0, -5.0,
  ])
  assert_true(outlines.path(1) is None)
  assert_true(outlines.path(2) is None)
  assert_eq(outlines.bounds(0), Some((0.0, 0.0, 10.0, 10.0)))
}
