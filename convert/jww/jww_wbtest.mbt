///|
test "jww detects and converts the old fixture" {
  let data = @base64.decode("") catch {
    _ => fail("JWW fixture base64 did not decode")
  }
  assert_true(detect(data))
  let result = try {
    convert(data)
  } catch {
    JwwInvalid(message) => fail("JWW fixture did not convert: " + message)
  }
  assert_eq(result.pages, 1)
  let document = @core.open_single(result.bdf) catch {
    _ => fail("JWW BDF did not open")
  }
  assert_eq(document.manifest.views[0].pages.length(), 1)
  assert_true(document.manifest.views[0].pages[0].width > 0.0)
}

///|
test "jww rejects a non-JWW input" {
  let rejected = try {
    let _ = convert(b"not a JWW file")
    false
  } catch {
    JwwInvalid(message) => message.contains("JWW")
  }
  assert_true(rejected)
}
