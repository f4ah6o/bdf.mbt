///|
fn grid_builtin_style(name : String) -> GridStyle? {
  let lower = name
    .replace_all(old="K", new="K")
    .to_lower()
    .replace_all(old="ſ", new="s")
  let key = if lower.has_prefix("tablestyle") {
    lower[10:].to_owned()
  } else {
    lower
  }
  match key {
    "dark1" =>
      Some({
        whole: style_region(0),
        first: style_region(1),
        second: style_region(-1),
        header: style_region(2),
      })
    "dark10" =>
      Some({
        whole: style_region(3),
        first: style_region(4),
        second: style_region(-1),
        header: style_region(5),
