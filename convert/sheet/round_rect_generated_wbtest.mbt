///|
fn check_round_rect_path(
  width : Double,
  height : Double,
  adjustment : Int64,
  verbs : Bytes,
  expected : Array[UInt32],
) -> Unit raise {
  let path = sheet_round_rect_path(width, height, adjustment)
  assert_eq(path.verbs, verbs)
  for i in 0..<expected.length() {
    assert_eq(
      Float::from_double(path.coordinates[i]).reinterpret_as_uint(),
      expected[i],
    )
  }
}
