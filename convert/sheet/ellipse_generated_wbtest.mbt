///|
fn check_ellipse_path(
  width : Double,
  height : Double,
  expected : Array[UInt32],
) -> Unit raise {
  let path = sheet_ellipse_path(width, height)
  for i in 0..<expected.length() {
    assert_eq(
      Float::from_double(path.coordinates[i]).reinterpret_as_uint(),
      expected[i],
    )
  }
}
