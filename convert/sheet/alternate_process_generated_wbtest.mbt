///|
fn check_alternate_process_path(
  width : Double,
  height : Double,
  verbs : Bytes,
  expected : Array[UInt32],
) -> Unit raise {
  let path = sheet_rounded_preset_path(
    width,
    height,
    Double::min(width, height) / 6.0,
  )
  assert_eq(path.verbs, verbs)
  assert_eq(path.coordinates.length(), expected.length())
  for i in 0..<expected.length() {
    assert_eq(
      Float::from_double(path.coordinates[i]).reinterpret_as_uint(),
      expected[i],
    )
  }
}
