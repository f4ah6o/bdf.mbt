///|
fn check_formula_multi_path(
  name : String,
  width : Double,
  height : Double,
  adjustment : Int64?,
  extra : Map[String, Int64],
  expected : Array[UInt32],
) -> Unit raise {
  let path = sheet_formula_preset_path(name, width, height, adjustment, extra~)
  assert_eq(path.coordinates.length(), expected.length())
  for i in 0..<expected.length() {
    assert_eq(
      Float::from_double(path.coordinates[i]).reinterpret_as_uint(),
      expected[i],
    )
  }
}
