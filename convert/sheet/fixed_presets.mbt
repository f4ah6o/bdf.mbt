///|
// Fixed-coordinate paths from the upstream DrawingML preset geometries.
fn sheet_fixed_preset_path(
  geometry : String,
  width : Double,
  height : Double,
) -> @core.Path {
  let (extent, points) : (Double, Array[(Double, Double)]) = match geometry {
    "flowChartCollate" =>
      (
        2.0,
        [(0.0, 0.0), (2.0, 0.0), (1.0, 1.0), (2.0, 2.0), (0.0, 2.0), (1.0, 1.0)],
      )
    "flowChartManualInput" =>
      (5.0, [(0.0, 1.0), (5.0, 0.0), (5.0, 5.0), (0.0, 5.0)])
    "flowChartManualOperation" =>
      (5.0, [(0.0, 0.0), (5.0, 0.0), (4.0, 5.0), (1.0, 5.0)])
    "flowChartOffpageConnector" =>
      (10.0, [(0.0, 0.0), (10.0, 0.0), (10.0, 8.0), (5.0, 10.0), (0.0, 8.0)])
    "irregularSeal1" =>
      (
        21600.0,
        [
          (10800.0, 5800.0),
          (14522.0, 0.0),
          (14155.0, 5325.0),
          (18380.0, 4457.0),
          (16702.0, 7315.0),
          (21097.0, 8137.0),
          (17607.0, 10475.0),
          (21600.0, 13290.0),
          (16837.0, 12942.0),
          (18145.0, 18095.0),
          (14020.0, 14457.0),
          (13247.0, 19737.0),
          (10532.0, 14935.0),
          (8485.0, 21600.0),
          (7715.0, 15627.0),
          (4762.0, 17617.0),
          (5667.0, 13937.0),
          (135.0, 14587.0),
          (3722.0, 11775.0),
          (0.0, 8615.0),
          (4627.0, 7617.0),
          (370.0, 2295.0),
          (7312.0, 6320.0),
          (8352.0, 2295.0),
        ],
      )
    "irregularSeal2" =>
      (
        21600.0,
        [
          (11462.0, 4342.0),
          (14790.0, 0.0),
          (14525.0, 5777.0),
          (18007.0, 3172.0),
          (16380.0, 6532.0),
          (21600.0, 6645.0),
          (16985.0, 9402.0),
          (18270.0, 11290.0),
          (16380.0, 12310.0),
          (18877.0, 15632.0),
          (14640.0, 14350.0),
          (14942.0, 17370.0),
          (12180.0, 15935.0),
          (11612.0, 18842.0),
          (9872.0, 17370.0),
          (8700.0, 19712.0),
          (7527.0, 18125.0),
          (4917.0, 21600.0),
          (4805.0, 18240.0),
          (1285.0, 17825.0),
          (3330.0, 15370.0),
          (0.0, 12877.0),
          (3935.0, 11592.0),
          (1172.0, 8270.0),
          (5372.0, 7817.0),
          (4502.0, 3625.0),
          (8550.0, 6382.0),
          (9722.0, 1887.0),
        ],
      )
    "lightningBolt" =>
      (
        21600.0,
        [
          (8472.0, 0.0),
          (12860.0, 6080.0),
          (11050.0, 6797.0),
          (16577.0, 12007.0),
          (14767.0, 12877.0),
          (21600.0, 21600.0),
          (10012.0, 14915.0),
          (12222.0, 13987.0),
          (5022.0, 9705.0),
          (7602.0, 8382.0),
          (0.0, 3890.0),
        ],
      )
    _ => abort("unknown fixed preset")
  }
  let sx = width / extent
  let sy = height / extent
  let verbs : Array[Byte] = []
  let coordinates : Array[Double] = []
  for i, (x, y) in points {
    verbs.push(if i == 0 { b'\x00' } else { b'\x01' })
    coordinates.push(x * sx)
    coordinates.push(y * sy)
  }
  verbs.push(b'\x04')
  { verbs: Bytes::from_array(verbs), coordinates, }
}
