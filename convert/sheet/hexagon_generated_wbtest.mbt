///|
fn check_hexagon_path(
  width : Double,
  height : Double,
  adjustment : Int64,
  expected : Array[UInt32],
) -> Unit raise {
  let path = sheet_hexagon_path(width, height, adjustment)
  for i in 0..<expected.length() {
    assert_eq(
      Float::from_double(path.coordinates[i]).reinterpret_as_uint(),
      expected[i],
    )
  }
}
