///|
test "hpgl converts a simple plot" {
  let result = convert(
    b"IN;SP1;PU100,100;PD500,500;PG;",
  ) catch {
    _ => fail("simple plot did not convert")
  }
  assert_eq(result.pages, 1)
  assert_true(result.bdf.length() > 0)
  let document = @core.open_single(result.bdf) catch {
    _ => fail("converted BDF did not open")
  }
  assert_eq(document.manifest.views.length(), 1)
  assert_eq(document.manifest.views[0].pages.length(), 1)
  assert_true(document.manifest.views[0].pages[0].width > 0.0)
  assert_true(document.manifest.views[0].pages[0].height > 0.0)
}

///|
test "hpgl rejects text that is not a plot" {
  let message = try {
    let _ = convert(b"this is not a plot")
    ""
  } catch {
    HpglInvalid(value) => value
  }
  assert_true(message.contains("HP-GL"), msg=message)
}

///|
test "hpgl detects plot instructions" {
  assert_true(detect(b"IN;SP1;PU0,0;PD100,100;"))
  assert_false(detect(b"this is not a plot"))
}

///|
test "hpgl converts the HP-GL pen plotter fixture" {
  let data = @base64.decode("") catch {
    _ => fail("fixture base64 did not decode")
  }
  let result = try {
    convert(data)
  } catch {
    HpglInvalid(message) => fail("pen plotter fixture did not convert: " + message)
  }
  assert_eq(result.pages, 1)
  let document = @core.open_single(result.bdf) catch {
    _ => fail("fixture BDF did not open")
  }
  assert_eq(document.manifest.views[0].pages.length(), 1)
}

///|
test "hpgl converts the HP-GL/2 shape fixture" {
  let data = @base64.decode("") catch {
    _ => fail("fixture base64 did not decode")
  }
  let result = try {
    convert(data)
  } catch {
    HpglInvalid(message) => fail("shape fixture did not convert: " + message)
  }
  assert_eq(result.pages, 1)
  assert_true(result.warnings.length() >= 0)
}

///|
test "hpgl converts a label" {
  let message = try {
    let result = convert(b"IN;SP1;PU100,100;LBHELLO\x03PG;")
    assert_eq(result.pages, 1)
    ""
  } catch {
    HpglInvalid(value) => value
    _ => "unexpected error"
  }
  assert_eq(message, "")
}
