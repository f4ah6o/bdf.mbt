///|
test "date and time classification matches upstream CSV cases" {
  for
    value in [
      "2024-01-02", "2024/1/2", "2024.01.02", "1/2/2024", "31/12/2024", "12/31/24",
      "1/2", "2024-02", "2024/2", "2-Jan-2024", "02-Jan-24", "Jan-24", "Jan 2, 2024",
      "2 January 2024", "9:30", "09:30:15", "9:30:15.250", "9:30 PM", "2024-01-02T03:04:05Z",
      "2024-01-02T03:04:05+09:00", "2024-01-02 03:04", "2024/1/2 3:04:05", "2024年1月2日",
      "2024年1月", "1月2日", "令和6年1月2日", "令和元年5月1日", "R6.1.2",
      "H31.4.30",
    ] {
    assert_true(looks_date_time(value), msg=value)
  }
  for
    value in [
      "2024-13-01", "2023-02-29", "25:00", "9:60", "abc", "12abc", "1-2", "Jan",
      "13/13/2024", "2024年13月1日", "No. 5",
    ] {
    assert_false(looks_date_time(value), msg=value)
  }
}
