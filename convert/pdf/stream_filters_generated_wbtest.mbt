///|
fn check_pdf_stream_filters(
  data : Bytes,
  filters : Array[PdfStreamFilter],
  limit : Int64,
  cut : Bool,
  expected : (Bytes, Bytes?)?,
) -> Unit raise {
  let actual : (Bytes, Bytes?)? = Some(
    pdf_decode_stream(data, filters, limit, cut, 268435456L),
  ) catch {
    _ => None
  }
  assert_eq(actual, expected)
}
