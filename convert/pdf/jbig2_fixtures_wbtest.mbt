///|
// JBIG2 decoder fixtures from upstream converter/internal/jbig2/testdata. Each
// page stream (optionally preceded by a globals stream) decodes to the page
// bitmap that Ghostscript rendered from it, so the tests compare the packed
// page bytes with that reference rendering.
priv struct PdfJbig2Fixture {
  name : String
  width : Int
  height : Int
  black : Int
  fnv : UInt64
  page : Array[Byte]
  globals : Array[Byte]
}

///|
fn pdf_jbig2_fixture_fnv(data : Array[Byte]) -> UInt64 {
  let mut h : UInt64 = 1469598103934665603UL
  for byte in data {
    h = h ^ byte.to_uint64()
    h = h * 1099511628211UL
  }
  h
}

///|
fn pdf_jbig2_fixture_black(bits : Bytes, w : Int, h : Int) -> Int {
  let stride = (w + 7) / 8
  let mut n = 0
  for y in 0..<h {
    for x in 0..<w {
      if ((bits[y * stride + x / 8].to_int() >> (7 - x % 8)) & 1) != 0 {
        n += 1
      }
    }
  }
  n
}

///|
fn pdf_jbig2_check_fixture(f : PdfJbig2Fixture) -> Unit raise {
  let (w, h, bits) = if f.globals.length() > 0 {
    pdf_jbig2_decode_with_globals(
      Bytes::from_array(f.page),
      Bytes::from_array(f.globals),
    )
  } else {
    pdf_jbig2_decode(Bytes::from_array(f.page))
  }
  assert_eq(w, f.width, msg="JBIG2 fixture \{f.name} width")
  assert_eq(h, f.height, msg="JBIG2 fixture \{f.name} height")
  assert_eq(
    pdf_jbig2_fixture_black(bits, w, h),
    f.black,
    msg="JBIG2 fixture \{f.name} black pixels",
  )
  assert_eq(
    pdf_jbig2_fixture_fnv(bits.to_array()),
    f.fnv,
    msg="JBIG2 fixture \{f.name} page bytes",
  )
}

