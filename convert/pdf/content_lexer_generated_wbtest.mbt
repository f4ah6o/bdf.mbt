///|
fn check_content_tokens(
  input : Bytes,
  expected : Array[ContentToken],
) -> Unit raise {
  let lexer : ContentLexer = { data: input, pos: 0, }
  for token in expected {
    assert_eq(lexer.next(0), token)
  }
  assert_eq(lexer.next(0), End)
}

///|
fn check_inline_image(
  input : Bytes,
  length : Int32,
  expected : Bytes,
  position : Int32,
) -> Unit raise {
  let lexer : ContentLexer = { data: input, pos: 0, }
  assert_eq(lexer.read_inline_image(length), expected)
  assert_eq(lexer.pos, position)
}
