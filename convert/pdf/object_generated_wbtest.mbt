///|
fn check_pdf_object_depth(input : Bytes, expected : Bool) -> Unit raise {
  let reader : PdfObjectReader = { data: input, pos: 0, }
  let actual = try {
    ignore(reader.read(0))
    true
  } catch {
    _ => false
  }
  assert_eq(actual, expected)
}

///|
fn check_pdf_object(
  input : Bytes,
  expected : (PdfObject, Int32)?,
) -> Unit raise {
  let reader : PdfObjectReader = { data: input, pos: 0, }
  let actual : (PdfObject, Int32)? = try {
    let value = reader.read(0)
    Some((normalize_pdf_object(value), reader.pos))
  } catch {
    _ => None
  }
  assert_eq(actual, expected, msg=@utf8.decode_lossy(input[:]))
}
