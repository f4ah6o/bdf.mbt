///|
fn check_pdf_cjk_unicode(
  collection : String,
  cid : Int64,
  unicode : (Int64, Bool)?,
  vertical : Int64?,
) -> Unit raise {
  assert_eq(pdf_cjk_unicode(collection, cid), unicode)
  assert_eq(pdf_cjk_vertical_form(collection, cid), vertical)
}
