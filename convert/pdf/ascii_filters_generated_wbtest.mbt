///|
fn check_pdf_ascii(kind : Int32, data : Bytes, expected : Bytes?) -> Unit raise {
  let actual : Bytes? = try {
    if kind == 0 {
      Some(pdf_decode_ascii_hex(data))
    } else {
      Some(pdf_decode_ascii85(data))
    }
  } catch {
    _ => None
  }
  assert_eq(actual, expected)
}
