///|
fn check_pdf_flate_digest(
  input : Bytes,
  max : Int64,
  length : Int32,
  expected : UInt64,
) -> Unit raise {
  let actual = pdf_inflate_up_to(input, 1, 1, 8, 1, max)
  assert_eq(actual.length(), length)
  let mut digest = 14695981039346656037UL
  for b in actual {
    digest = (digest ^ b.to_uint64()) * 1099511628211UL
  }
  assert_eq(digest, expected)
}

///|
fn check_pdf_flate(
  input : Bytes,
  predictor : Int32,
  colors : Int32,
  bits : Int32,
  columns : Int32,
  max : Int64,
  expected : Bytes?,
) -> Unit raise {
  let actual : Bytes? = Some(
    pdf_inflate_up_to(input, predictor, colors, bits, columns, max),
  ) catch {
    _ => None
  }
  assert_eq(actual, expected)
}
