///|
test "dxf converts a Shift_JIS R12 drawing" {
  let data = @base64.decode("") catch {
    _ => fail("DXF fixture base64 did not decode")
  }
  assert_true(detect(data))
  let result = convert(data) catch {
    error => fail("DXF fixture did not convert")
  }
  assert_eq(result.pages, 1)
  let document = @core.open_single(result.bdf) catch {
    _ => fail("DXF BDF did not open")
  }
  assert_eq(document.manifest.views[0].pages.length(), 1)
}

///|
test "dxf rejects a non-DXF input" {
  let rejected = try {
    let _ = convert(b"not a DXF file")
    false
  } catch {
    DxfInvalid(message) => message.contains("DXF")
  }
  assert_true(rejected)
}
