///|
test "XMP dates preserve precision and normalize EXIF forms" {
  for
    (input, expected) in [
      ("2026", "2026"),
      ("2026-09", "2026-09"),
      ("2026-09-01T10:20", "2026-09-01T10:20"),
      ("2026-09-01T10:20:30.25+0900", "2026-09-01T10:20:30.25+09:00"),
      ("2026:09:01 10:20:30Z", "2026-09-01T10:20:30Z"),
      ("2026-13-01", ""),
      ("0000", ""),
      ("2026-09-01T25:00", ""),
      ("2026-09-01T10:20.1Z", ""),
    ] {
    assert_eq(xmp_date(input), expected)
  }
}
