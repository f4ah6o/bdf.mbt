<mxfile host="test">
  <diagram id="math" name="Math">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" math="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Formulas in labels&lt;/b&gt; (math=1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="display" value="The roots of \(ax^2+bx+c=0\) are$$x = \frac{-b \pm \sqrt{b^2-4ac}}{2a}$$when \(a \ne 0\)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="wrap" value="Inline formulas such as \(e^{i\pi}+1=0\) and \(\sum_{k=1}^{n} k = \frac{n(n+1)}{2}\) wrap with the words around them, left aligned." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="280" y="50" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ja" value="二次方程式の判別式 \(D=b^2-4ac\) が正のとき、実数解は二つです。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="520" y="50" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="matrix" value="$$A=\begin{pmatrix}1 &amp; 2\\ 3 &amp; 4\end{pmatrix}$$" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a5c1a;" vertex="1" parent="1">
          <mxGeometry x="520" y="150" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="plain" value="Plain label: \(\int_0^1 x\,dx = \frac{1}{2}\)&#xa;on lines of their own: \(x^2\)" style="rounded=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="210" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ascii" value="AsciiMath stays text: `sqrt(x^2+1)`" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="200" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="big" value="&lt;font style=&quot;font-size: 18px&quot;&gt;Larger: \(\lim_{h \to 0} \frac{f(x+h)-f(x)}{h}\)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="240" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="\(f\colon X \to Y\)" style="endArrow=classic;html=1;" edge="1" parent="1" source="display" target="matrix">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="260" y="330" as="sourcePoint" />
            <mxPoint x="620" y="330" as="targetPoint" />
            <Array as="points">
              <mxPoint x="140" y="330" />
              <mxPoint x="620" y="330" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
