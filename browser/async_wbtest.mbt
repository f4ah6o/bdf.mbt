///|
extern "js" fn resolved_promise() -> @js_async.Promise[Int32] =
  #|() => Promise.resolve(42)

///|
async test "javascript promise bridge" {
  assert_eq(resolved_promise().wait(), 42)
}

///|
#external
priv type SavedGlobals

///|
extern "js" fn save_globals() -> SavedGlobals =
  #|() => ({ document: globalThis.document, FontFace: globalThis.FontFace, createImageBitmap: globalThis.createImageBitmap })

///|
extern "js" fn restore_globals(saved : SavedGlobals) -> Unit =
  #|(saved) => { for (const k of ["document", "FontFace", "createImageBitmap"]) { if (saved[k] === undefined) delete globalThis[k]; else globalThis[k] = saved[k]; } }

///|
extern "js" fn resource_fixture_host(fail_font : Bool) -> BrowserHost =
  #|(failFont) => {
  #|  const stats={ images:0, closed:0, fontsAdded:0, fontsDeleted:0, calls:[] };
  #|  globalThis.createImageBitmap=async () => { stats.images++; return {width:2,height:2,close(){stats.closed++;}}; };
  #|  globalThis.FontFace=class { constructor(name,bytes){this.family=name;this.bytes=bytes;} async load(){if(failFont) throw new Error("bad font");return this;} };
  #|  const ctx={
  #|    scale(){}, save(){stats.calls.push("save");}, restore(){stats.calls.push("restore");},
  #|    translate(x,y){stats.calls.push(["translate",x,y]);},
  #|    createPattern(image,repeat){if(stats.failPattern) throw new Error("pattern failed");stats.calls.push(["pattern",repeat]);return {setTransform(){}};},
  #|    fillRect(...a){stats.calls.push(["rect",...a]);},
  #|    drawImage(image,...a){stats.calls.push(["image",...a]);},
  #|    fillText(text,x,y){stats.calls.push(["text",text,x,y,this.font]);}
  #|  };
  #|  globalThis.document={fonts:{add(){stats.fontsAdded++;},delete(){stats.fontsDeleted++;}},createElement(){return {style:{},dataset:{},children:[],appendChild(c){this.children.push(c)},setAttribute(){},getContext(){return ctx;}};}};
  #|  return {stats,style:{},children:[],replaceChildren(){this.children=[];},appendChild(c){this.children.push(c);}};
  #|}

///|
extern "js" fn resource_fixture_result(host : BrowserHost) -> Bool =
  #|(h) => {
  #|  const s=h.stats, font='normal 400 12px "bdf-f985e73e9161ad584c62703a54ffbb05"';
  #|  return s.images===1 && s.closed===0 && s.fontsAdded===1 && s.fontsDeleted===0 && h.children.length===1 &&
  #|    JSON.stringify(s.calls)===JSON.stringify([["rect",0,0,60,30],"save",["pattern","repeat-x"],["rect",0,0,10,10],["image",10,0,10,10],["text","A",4,20,font],"save",["translate",25,0],["image",1,2,3,4],["image",0,0,1,1,5,6,7,8],"restore","restore"]);
  #|}

///|
extern "js" fn fail_pattern(host : BrowserHost) -> Unit =
  #|(h) => { h.stats.failPattern=true; }

///|
extern "js" fn resource_draw_failure_result(host : BrowserHost) -> Bool =
  #|(h) => h.stats.images===1 && h.stats.closed===1 && h.stats.fontsAdded===1 && h.stats.fontsDeleted===1

///|
extern "js" fn resource_failure_result(host : BrowserHost) -> Bool =
  #|(h) => h.stats.images===1 && h.stats.closed===1 && h.stats.fontsAdded===0 && h.children.length===0

