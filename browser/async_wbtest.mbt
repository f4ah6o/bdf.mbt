  let host = resource_fixture_host(false)
  assert_eq(mount_bdf_async(host, data, "single").wait(), 1)
  assert_true(resource_fixture_result(host))
  unmount_bdf(host)
  assert_true(resource_draw_failure_result(host))
  let failing_host = resource_fixture_host(true)
  let failed = try {
    ignore(mount_bdf_async(failing_host, data, "single").wait())
    false
  } catch {
    _ => true
  }
  assert_true(failed && resource_failure_result(failing_host))
  let draw_failure_host = resource_fixture_host(false)
  fail_pattern(draw_failure_host)
  let draw_failed = try {
    ignore(mount_bdf_async(draw_failure_host, data, "single").wait())
    false
  } catch {
    _ => true
  }
  assert_true(draw_failed && resource_draw_failure_result(draw_failure_host))
  let large_host = resource_fixture_host(false)
  let resources = new_resources()
  let huge_png : Bytes = b"\x89PNG\x0d\x0a\x1a\x0a\x00\x00\x00\x0dIHDR\x00\x01\x00\x00\x00\x01\x00\x00"
  load_image(resources, "huge", huge_png).wait()
  assert_true(
    has_image(resources, "huge") && no_decode_for_large_image(large_host),
  )
  dispose_resources(resources)
}

///|
extern "js" fn no_decode_for_large_image(host : BrowserHost) -> Bool =
  #|(h) => h.stats.images === 0

///|
extern "js" fn catches_js_error(action : () -> Int32) -> Bool =
  #|(action) => { try { action(); return false; } catch (_) { return true; } }

///|
extern "js" fn empty_host() -> BrowserHost =
  #|() => null

///|
test "synchronous JavaScript entry throws on malformed input" {
  let host = empty_host()
  assert_true(catches_js_error(() => mount_bdf_js(host, b"\x00", "single")))
}
