///|
extern "js" fn child_fixture_host() -> BrowserHost =
  #|() => {
  #|  const ctx = {calls: [], scale() {},
  #|    save() { this.calls.push(["save"]); },
  #|    restore() { this.calls.push(["restore"]); },
  #|    translate(x,y) { this.calls.push(["translate",x,y]); },
  #|    fillRect(...args) { this.calls.push(["rect",...args]); }
  #|  };
  #|  const canvas = {style:{},setAttribute(){},getContext(){return ctx;}};
  #|  globalThis.document = {createElement() {return canvas;}};
  #|  return {ctx,style:{},replaceChildren(){},appendChild(){}};
  #|}

///|
extern "js" fn child_fixture_result(host : BrowserHost) -> Bool =
  #|(host) => JSON.stringify(host.ctx.calls) === JSON.stringify([["save"],["rect",1,2,3,4],["restore"],["save"],["translate",5,6],["rect",1,2,3,4],["restore"]])

///|
extern "js" fn child_restored(ctx : CanvasContext) -> Bool =
  #|(ctx) => JSON.stringify(ctx.calls) === '[["save"],["restore"]]'

///|
// Generated by shibukawa/bdf 4f9af52 with Document.WriteSingle and
// MinCompress = 1 << 30. A parent uses the same child twice.
test "mount draws child objects with isolated state" {
  let host = child_fixture_host()
  let data : Bytes = b"\x62\x64\x66\x00\x01\x00\x00\x00\x20\x00\x00\x00\x00\x00\x00\x00\x8c\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x7b\x22\x62\x64\x66\x22\x3a\x31\x2c\x22\x6f\x70\x73\x65\x74\x22\x3a\x31\x2c\x22\x75\x6e\x69\x74\x22\x3a\x22\x70\x74\x22\x2c\x22\x6d\x65\x74\x61\x22\x3a\x7b\x22\x67\x65\x6e\x65\x72\x61\x74\x6f\x72\x22\x3a\x22\x62\x64\x66\x2d\x67\x6f\x2f\x30\x2e\x31\x22\x7d\x2c\x22\x76\x69\x65\x77\x73\x22\x3a\x5b\x7b\x22\x69\x64\x22\x3a\x22\x70\x22\x2c\x22\x6b\x69\x6e\x64\x22\x3a\x22\x66\x69\x78\x65\x64\x22\x2c\x22\x70\x61\x67\x65\x73\x22\x3a\x5b\x7b\x22\x77\x22\x3a\x32\x30\x2c\x22\x68\x22\x3a\x32\x30\x2c\x22\x6c\x61\x79\x65\x72\x73\x22\x3a\x5b\x7b\x22\x72\x6f\x6c\x65\x22\x3a\x22\x62\x6f\x64\x79\x22\x2c\x22\x6f\x62\x6a\x22\x3a\x22\x32\x37\x61\x36\x39\x32\x33\x62\x33\x35\x30\x31\x37\x33\x32\x34\x36\x66\x37\x35\x38\x66\x64\x37\x62\x33\x30\x62\x32\x66\x30\x66\x22\x7d\x5d\x7d\x5d\x7d\x5d\x2c\x22\x70\x61\x72\x74\x73\x22\x3a\x5b\x7b\x22\x68\x22\x3a\x22\x65\x31\x35\x63\x65\x66\x61\x63\x38\x34\x32\x65\x31\x31\x66\x65\x62\x34\x39\x33\x64\x63\x39\x34\x34\x34\x35\x37\x62\x35\x66\x38\x22\x2c\x22\x74\x22\x3a\x22\x6f\x62\x6a\x22\x2c\x22\x65\x6e\x63\x22\x3a\x22\x69\x64\x65\x6e\x74\x69\x74\x79\x22\x2c\x22\x6c\x65\x6e\x22\x3a\x34\x38\x2c\x22\x73\x69\x7a\x65\x22\x3a\x34\x38\x2c\x22\x6f\x66\x66\x22\x3a\x30\x7d\x2c\x7b\x22\x68\x22\x3a\x22\x32\x37\x61\x36\x39\x32\x33\x62\x33\x35\x30\x31\x37\x33\x32\x34\x36\x66\x37\x35\x38\x66\x64\x37\x62\x33\x30\x62\x32\x66\x30\x66\x22\x2c\x22\x74\x22\x3a\x22\x6f\x62\x6a\x22\x2c\x22\x65\x6e\x63\x22\x3a\x22\x69\x64\x65\x6e\x74\x69\x74\x79\x22\x2c\x22\x6c\x65\x6e\x22\x3a\x35\x39\x2c\x22\x73\x69\x7a\x65\x22\x3a\x35\x39\x2c\x22\x6f\x66\x66\x22\x3a\x34\x38\x7d\x5d\x7d\x42\x4f\x42\x4a\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x80\x40\x00\x00\xa0\x40\x00\x00\x00\x00\x00\x00\x11\x20\x00\x00\x80\x3f\x00\x00\x00\x40\x00\x00\x40\x40\x00\x00\x80\x40\x42\x4f\x42\x4a\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xa0\x41\x00\x00\xa0\x41\x00\x00\x00\x00\x00\x01\xe1\x5c\xef\xac\x84\x2e\x11\xfe\xb4\x93\xdc\x94\x44\x57\xb5\xf8\x0c\x50\x00\x51\x00\x00\x00\xa0\x40\x00\x00\xc0\x40"
  assert_eq(mount_bdf(host, data, "single"), 1)
  assert_true(child_fixture_result(host))
  let doc = @core.open_single(data)
  let ctx = fake_context()
  let limits : UseLimits = { seen: {}, reused: 0, maximum: 1, }
  let deep = try {
    paint_child(ctx, doc, "missing", 0.0, 0.0, 64, false, limits, None)
    false
  } catch {
    _ => true
  }
  assert_true(deep)
  let too_many = try {
    paint_commands(
      ctx,
      [@render.Mark(0, ""), @render.Mark(0, "")],
      repeated=true,
      limits~,
    )
    false
  } catch {
    _ => true
  }
  assert_true(too_many)
  let failed_ctx = fake_context()
  let no_reuse : UseLimits = { seen: {}, reused: 0, maximum: 0, }
  let failed = try {
    paint_child(
      failed_ctx,
      doc,
      doc.manifest.parts[0].hash,
      0.0,
      0.0,
      0,
      true,
      no_reuse,
      None,
    )
    false
  } catch {
    _ => true
  }
  assert_true(failed && child_restored(failed_ctx))
}

///|
extern "js" fn cycle_restored(ctx : CanvasContext) -> Bool =
  #|(ctx) => ctx.calls.length === 128 && ctx.calls.slice(0,64).every(c => c[0] === "save") && ctx.calls.slice(64).every(c => c[0] === "restore")

///|
test "cyclic object references stop at the depth limit and unwind" {
  let ctx = fake_context()
  let data : Bytes = b"\x42\x4f\x42\x4a\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x23\x45\x67\x89\xab\xcd\xef\x01\x23\x45\x67\x89\xab\xcd\xef\x02\x50\x00"
  let hash = "0123456789abcdef0123456789abcdef"
  let part : @core.Part = {
    hash,
    kind: "obj",
    encoding: "identity",
    offset: 0,
    length: data.length(),
    size: data.length(),
  }
  let doc : @core.Document = {
    manifest: { parts: [part], views: [], },
    header: {
      version: 1,
      flags: 0,
      manifest_offset: 0,
      manifest_length: 0,
      manifest_encoding: 0,
    },
    data,
  }
  let limits : UseLimits = { seen: {}, reused: 0, maximum: 134217728, }
  let rejected = try {
    paint_child(ctx, doc, hash, 0.0, 0.0, 0, false, limits, None)
    false
  } catch {
    _ => true
  }
  assert_true(rejected && cycle_restored(ctx))
}

///|
test "groups and masks share a nesting limit" {
  let state : CanvasState = { ctx: fake_context(), groups: [], masks: [], }
  for _ in 0..<64 {
    state.groups.push(null_group())
  }
  let group_rejected = try {
    state.start_group(1.0, 0, 0.0, 0.0, 1.0, 1.0)
    false
  } catch {
    _ => true
  }
  let mask_rejected = try {
    state.start_mask(0, 0, b"")
    false
  } catch {
    _ => true
  }
  assert_true(group_rejected && mask_rejected)
}
