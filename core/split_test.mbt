  }
  let calls = Ref(0)
  let doc = @core.open_split(manifest, fn(hash, limit) {
    calls.val += 1
    match stored.get(hash) {
      Some(bytes) => {
        if bytes.length() > limit {
          raise Failure("stored part exceeds limit")
        }
        bytes
      }
      None => raise Failure("missing part")
    }
  })
  assert_eq(calls.val, 0)
  assert_eq(doc.manifest.views[0].pages.length(), 1)
  assert_eq(doc.part("0de661b4e3e89f4c61660febaf9e0c57"), b"small raw image")
  assert_eq(doc.part("69d0d207b21225f40bda5abfa65031ae").length(), 3432)
  assert_eq(calls.val, 2)
  assert_eq(doc.stored_part("69d0d207b21225f40bda5abfa65031ae").length(), 464)
  assert_eq(calls.val, 3)
  let missing = try {
    ignore(doc.part("../not-a-hash"))
    false
  } catch {
    _ => true
  }
  assert_true(missing)
  assert_eq(calls.val, 3)
  stored["69d0d207b21225f40bda5abfa65031ae"] = b"short"
  let mismatch = try {
    ignore(doc.part("69d0d207b21225f40bda5abfa65031ae"))
    false
  } catch {
    _ => true
  }
  assert_true(mismatch)
  assert_eq(calls.val, 4)
  doc.manifest.parts[0] = {
    hash: "../secret",
    kind: "obj",
    encoding: "identity",
    offset: 0,
    length: 1,
    size: 1,
  }
  let changed = try {
    ignore(doc.part("../secret"))
    false
  } catch {
    _ => true
  }
  assert_true(changed)
  assert_eq(calls.val, 4)
}

///|
test "split manifest is checked before invoking the loader" {
  let calls = Ref(0)
  let malformed : Bytes = b"{\"bdf\":1,\"parts\":[{\"h\":\"../secret\",\"t\":\"obj\",\"len\":1,\"size\":1}]}"
  let rejected = try {
    ignore(
      @core.open_split(malformed, fn(_, _) {
        calls.val += 1
        b""
      }),
    )
    false
  } catch {
    _ => true
  }
  assert_true(rejected)
  assert_eq(calls.val, 0)
}
