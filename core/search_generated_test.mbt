///|
// Generated by compat/search/generate.mjs from @bdfkit/core.
test "search query normalization matches upstream" {
  assert_eq(
    @core.normalize_query("ＡＢＣ ｶﾀｶﾅ Ⅸ", case_sensitive=false),
    "abc かたかな ix",
  )
  assert_eq(
    @core.normalize_query("ＡＢＣ ｶﾀｶﾅ Ⅸ", case_sensitive=true),
    "ABC かたかな IX",
  )
  assert_eq(@core.normalize_query("café", case_sensitive=false), "café")
  assert_eq(@core.normalize_query("café", case_sensitive=true), "café")
  assert_eq(
    @core.normalize_query("ｶﾞｲﾄﾞ", case_sensitive=false),
    "がいど",
  )
  assert_eq(
    @core.normalize_query("ｶﾞｲﾄﾞ", case_sensitive=true),
    "がいど",
  )
  assert_eq(@core.normalize_query("が", case_sensitive=false), "が")
  assert_eq(@core.normalize_query("が", case_sensitive=true), "が")
  assert_eq(@core.normalize_query("각", case_sensitive=false), "각")
  assert_eq(@core.normalize_query("각", case_sensitive=true), "각")
  assert_eq(@core.normalize_query("ạ́", case_sensitive=false), "ạ́")
  assert_eq(@core.normalize_query("ạ́", case_sensitive=true), "ạ́")
  assert_eq(@core.normalize_query("10⁻³", case_sensitive=false), "10-3")
  assert_eq(@core.normalize_query("10⁻³", case_sensitive=true), "10-3")
  assert_eq(
    @core.normalize_query("İΣ𐐀", case_sensitive=false),
    "i̇σ𐐨",
  )
  assert_eq(@core.normalize_query("İΣ𐐀", case_sensitive=true), "İΣ𐐀")
}

///|
test "upstream search: latin accents" {
  let runs : Array[@core.IndexRun] = [
    { a: 0, b: 0, ordinal: 0, separator: 0, text: "un café noir CAFÉ", },
  ]
  let search = @core.TextSearch::new(runs, case_sensitive=false)
  assert_eq(search.text(), "un café noir café")
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 3, end: 8, }],
        text: "café",
        context: "un café noir café",
      },
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 14, end: 18, }],
        text: "CAFÉ",
        context: "un café noir café",
      },
    ]
    assert_eq(search.search("café", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 3, end: 8, }],
        text: "café",
        context: "un café noir café",
      },
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 14, end: 18, }],
        text: "CAFÉ",
        context: "un café noir café",
      },
    ]
    assert_eq(search.search("CAFÉ", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = []
    assert_eq(search.search("cafe", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 6, end: 8, }],
        text: "é",
        context: "un café noir café",
      },
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 17, end: 18, }],
        text: "É",
        context: "un café noir café",
      },
    ]
    assert_eq(search.search("É", limit=1000, context=40), expected)
  }
  let expected : Array[@core.SearchHit] = [
    {
      segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 9, end: 13, }],
      text: "noir",
      context: "un café noir café",
    },
  ]
  assert_eq(search.search("noir", limit=1000, context=40), expected)
}

