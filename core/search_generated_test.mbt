    assert_eq(search.search("ガイド", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 0, end: 5, }],
        text: "ｶﾞｲﾄﾞ",
        context: "がいど かたかな きろ ぱ",
      },
    ]
    assert_eq(search.search("がいど", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 2, end: 3, }],
        text: "ｲ",
        context: "がいど かたかな きろ ぱ",
      },
    ]
    assert_eq(search.search("い", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 3, end: 5, }],
        text: "ﾄﾞ",
        context: "がいど かたかな きろ ぱ",
      },
    ]
    assert_eq(search.search("ド", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = []
    assert_eq(search.search("ト", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 11, end: 12, }],
        text: "㌔",
        context: "がいど かたかな きろ ぱ",
      },
    ]
    assert_eq(search.search("ろ", limit=1000, context=40), expected)
  }
  let expected : Array[@core.SearchHit] = [
    {
      segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 13, end: 15, }],
      text: "ﾊﾟ",
      context: "がいど かたかな きろ ぱ",
    },
  ]
  assert_eq(search.search("パ", limit=1000, context=40), expected)
}

///|
test "upstream search: hangul and marks" {
  let runs : Array[@core.IndexRun] = [
    { a: 0, b: 0, ordinal: 0, separator: 0, text: "𝒜 ạ́b x각y", },
  ]
  let search = @core.TextSearch::new(runs, case_sensitive=false)
  assert_eq(search.text(), "a ạ́b x각y")
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 3, end: 6, }],
        text: "ạ́",
        context: "a ạ́b x각y",
      },
    ]
    assert_eq(search.search("ạ́", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 0, end: 2, }],
        text: "𝒜",
        context: "a ạ́b x각y",
      },
    ]
    assert_eq(search.search("a", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 9, end: 12, }],
        text: "각",
        context: "a ạ́b x각y",
      },
    ]
    assert_eq(search.search("각", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 6, end: 7, }],
        text: "b",
        context: "a ạ́b x각y",
      },
    ]
    assert_eq(search.search("b", limit=1000, context=40), expected)
  }
  let expected : Array[@core.SearchHit] = [
    {
      segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 8, end: 13, }],
      text: "x각y",
      context: "a ạ́b x각y",
    },
  ]
  assert_eq(search.search("x각y", limit=1000, context=40), expected)
}

///|
test "upstream search: case and formula" {
  let runs : Array[@core.IndexRun] = [
    {
      a: 0,
      b: 0,
      ordinal: 0,
      separator: 0,
      text: "ＡＢＣ Ⅸ b^2−4ac İ Σς 𐐀",
    },
  ]
  let search = @core.TextSearch::new(runs, case_sensitive=false)
  assert_eq(search.text(), "abc ix b^2-4ac i̇ σς 𐐨")
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 0, end: 3, }],
        text: "ＡＢＣ",
        context: "abc ix b^2-4ac i̇ σς 𐐨",
      },
    ]
    assert_eq(search.search("abc", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 4, end: 5, }],
        text: "Ⅸ",
        context: "abc ix b^2-4ac i̇ σς 𐐨",
      },
    ]
    assert_eq(search.search("ix", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 6, end: 13, }],
        text: "b^2−4ac",
        context: "abc ix b^2-4ac i̇ σς 𐐨",
      },
    ]
    assert_eq(search.search("B^2-4AC", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 14, end: 15, }],
        text: "İ",
        context: "abc ix b^2-4ac i̇ σς 𐐨",
      },
    ]
    assert_eq(search.search("i̇", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 16, end: 17, }],
        text: "Σ",
        context: "abc ix b^2-4ac i̇ σς 𐐨",
      },
    ]
    assert_eq(search.search("σ", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 17, end: 18, }],
        text: "ς",
        context: "abc ix b^2-4ac i̇ σς 𐐨",
      },
    ]
    assert_eq(search.search("ς", limit=1000, context=40), expected)
  }
  let expected : Array[@core.SearchHit] = [
    {
      segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 19, end: 21, }],
      text: "𐐀",
      context: "abc ix b^2-4ac i̇ σς 𐐨",
    },
  ]
  assert_eq(search.search("𐐨", limit=1000, context=40), expected)
}

///|
test "upstream search: case sensitive" {
  let runs : Array[@core.IndexRun] = [
    { a: 0, b: 0, ordinal: 0, separator: 0, text: "ABC Abc ａｂｃ カナ", },
  ]
  let search = @core.TextSearch::new(runs, case_sensitive=true)
  assert_eq(search.text(), "ABC Abc abc かな")
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 0, end: 3, }],
        text: "ABC",
        context: "ABC Abc abc かな",
      },
    ]
    assert_eq(search.search("ABC", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 8, end: 11, }],
        text: "ａｂｃ",
        context: "ABC Abc abc かな",
      },
    ]
    assert_eq(search.search("abc", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 12, end: 14, }],
        text: "カナ",
        context: "ABC Abc abc かな",
      },
    ]
    assert_eq(search.search("カナ", limit=1000, context=40), expected)
  }
  let expected : Array[@core.SearchHit] = [
    {
      segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 12, end: 14, }],
      text: "カナ",
      context: "ABC Abc abc かな",
    },
  ]
  assert_eq(search.search("かな", limit=1000, context=40), expected)
}

///|
test "upstream search: boundaries" {
  let runs : Array[@core.IndexRun] = [
    { a: 0, b: 1, ordinal: 9, separator: 2, text: "Hello", },
    { a: 0, b: 1, ordinal: 10, separator: 1, text: "World", },
    { a: 0, b: 2, ordinal: 0, separator: 0, text: "wide", },
    { a: 1, b: 0, ordinal: 3, separator: 2, text: "next", },
  ]
  let search = @core.TextSearch::new(runs, case_sensitive=false)
  assert_eq(search.text(), "hello worldwide\nnext")
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [
          { run: 0, a: 0, b: 1, ordinal: 9, start: 0, end: 5, },
          { run: 1, a: 0, b: 1, ordinal: 10, start: 0, end: 5, },
        ],
        text: "Hello World",
        context: "hello worldwide ⏎ next",
      },
    ]
    assert_eq(search.search("hello world", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [
          { run: 1, a: 0, b: 1, ordinal: 10, start: 0, end: 5, },
          { run: 2, a: 0, b: 2, ordinal: 0, start: 0, end: 4, },
        ],
        text: "Worldwide",
        context: "hello worldwide ⏎ next",
      },
    ]
    assert_eq(search.search("WORLDWIDE", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = []
    assert_eq(search.search("wide next", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [
          { run: 2, a: 0, b: 2, ordinal: 0, start: 0, end: 4, },
          { run: 3, a: 1, b: 0, ordinal: 3, start: 0, end: 4, },
        ],
        text: "widenext",
        context: "hello worldwide ⏎ next",
      },
    ]
    assert_eq(search.search("wide\u{0}next", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 3, a: 1, b: 0, ordinal: 3, start: 0, end: 4, }],
        text: "next",
        context: "hello worldwide ⏎ next",
      },
    ]
    assert_eq(search.search("next", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = []
    assert_eq(search.search(" ", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = []
    assert_eq(search.search("", limit=1000, context=40), expected)
  }
  let expected : Array[@core.SearchHit] = [
    {
      segments: [{ run: 0, a: 0, b: 1, ordinal: 9, start: 4, end: 5, }],
      text: "o",
      context: "hello worldwide ⏎ next",
    },
    {
      segments: [{ run: 1, a: 0, b: 1, ordinal: 10, start: 1, end: 2, }],
      text: "o",
      context: "hello worldwide ⏎ next",
    },
  ]
  assert_eq(search.search("o", limit=1000, context=40), expected)
}

///|
test "upstream search: split normalization" {
  let runs : Array[@core.IndexRun] = [
    { a: 0, b: 0, ordinal: 0, separator: 0, text: "e", },
    { a: 0, b: 0, ordinal: 0, separator: 0, text: "́x", },
  ]
  let search = @core.TextSearch::new(runs, case_sensitive=false)
  assert_eq(search.text(), "éx")
  {
    let expected : Array[@core.SearchHit] = []
    assert_eq(search.search("é", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = []
    assert_eq(search.search("éx", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 0, end: 1, }],
        text: "e",
        context: "éx",
      },
    ]
    assert_eq(search.search("e", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 1, a: 0, b: 0, ordinal: 0, start: 0, end: 1, }],
        text: "́",
        context: "éx",
      },
    ]
    assert_eq(search.search("́", limit=1000, context=40), expected)
  }
  let expected : Array[@core.SearchHit] = [
    {
      segments: [{ run: 1, a: 0, b: 0, ordinal: 0, start: 1, end: 2, }],
      text: "x",
      context: "éx",
    },
  ]
  assert_eq(search.search("x", limit=1000, context=40), expected)
}

///|
test "upstream search: overlap and context" {
  let runs : Array[@core.IndexRun] = [
    { a: 0, b: 0, ordinal: 0, separator: 0, text: "banana", },
    { a: 2, b: 3, ordinal: 4, separator: 2, text: "BANANA", },
  ]
  let search = @core.TextSearch::new(runs, case_sensitive=false)
  assert_eq(search.text(), "banana\nbanana")
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 1, end: 4, }],
        text: "ana",
        context: "banana",
      },
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 3, end: 6, }],
        text: "ana",
        context: "anana ⏎ b",
      },
      {
        segments: [{ run: 1, a: 2, b: 3, ordinal: 4, start: 1, end: 4, }],
        text: "ANA",
        context: " ⏎ banana",
      },
      {
        segments: [{ run: 1, a: 2, b: 3, ordinal: 4, start: 3, end: 6, }],
        text: "ANA",
        context: "anana",
      },
    ]
    assert_eq(search.search("ana", limit=4, context=2), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 1, end: 2, }],
        text: "a",
        context: "bana",
      },
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 3, end: 4, }],
        text: "a",
        context: "anana",
      },
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 5, end: 6, }],
        text: "a",
        context: "ana ⏎ b",
      },
      {
        segments: [{ run: 1, a: 2, b: 3, ordinal: 4, start: 1, end: 2, }],
        text: "A",
        context: " ⏎ bana",
      },
    ]
    assert_eq(search.search("a", limit=4, context=2), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 2, end: 5, }],
        text: "nan",
        context: "banana ⏎ ",
      },
      {
        segments: [{ run: 1, a: 2, b: 3, ordinal: 4, start: 2, end: 5, }],
        text: "NAN",
        context: "banana",
      },
    ]
    assert_eq(search.search("nan", limit=4, context=2), expected)
  }
  let expected : Array[@core.SearchHit] = [
    {
      segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 0, end: 6, }],
      text: "banana",
      context: "banana ⏎ b",
    },
    {
      segments: [{ run: 1, a: 2, b: 3, ordinal: 4, start: 0, end: 6, }],
      text: "BANANA",
      context: "a ⏎ banana",
    },
  ]
  assert_eq(search.search("banana", limit=4, context=2), expected)
}

///|
test "upstream search: query whitespace" {
  let runs : Array[@core.IndexRun] = [
    { a: 0, b: 0, ordinal: 0, separator: 0, text: "a b cd", },
  ]
  let search = @core.TextSearch::new(runs, case_sensitive=false)
  assert_eq(search.text(), "a b cd")
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 0, end: 3, }],
        text: "a b",
        context: "a b cd",
      },
    ]
    assert_eq(search.search("a\t\n b", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 2, end: 5, }],
        text: "b c",
        context: "a b cd",
      },
    ]
    assert_eq(search.search("b c", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 4, end: 7, }],
        text: "cd",
        context: "a b cd",
      },
    ]
    assert_eq(search.search("cd", limit=1000, context=40), expected)
  }
  let expected : Array[@core.SearchHit] = [
    {
      segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 1, end: 2, }],
      text: " ",
      context: "a b cd",
    },
    {
      segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 3, end: 4, }],
      text: " ",
      context: "a b cd",
    },
  ]
  assert_eq(search.search("﻿", limit=1000, context=40), expected)
}

///|
test "upstream search: empty and other separator" {
  let runs : Array[@core.IndexRun] = [
    { a: 0, b: 0, ordinal: 0, separator: 0, text: "", },
    { a: 0, b: 0, ordinal: 0, separator: 7, text: "a", },
    { a: 0, b: 0, ordinal: 0, separator: 1, text: "", },
    { a: 0, b: 0, ordinal: 0, separator: 1, text: "b", },
  ]
  let search = @core.TextSearch::new(runs, case_sensitive=false)
  assert_eq(search.text(), " a  b")
  {
    let expected : Array[@core.SearchHit] = []
    assert_eq(search.search("a b", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = []
    assert_eq(search.search("a  b", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = []
    assert_eq(search.search(" ", limit=1000, context=40), expected)
  }
  let expected : Array[@core.SearchHit] = [
    {
      segments: [{ run: 3, a: 0, b: 0, ordinal: 0, start: 0, end: 1, }],
      text: "b",
      context: " a  b",
    },
  ]
  assert_eq(search.search("b", limit=1000, context=40), expected)
}

///|
test "upstream search: limit zero" {
  let runs : Array[@core.IndexRun] = [
    { a: 0, b: 0, ordinal: 0, separator: 0, text: "aaaa", },
  ]
  let search = @core.TextSearch::new(runs, case_sensitive=false)
  assert_eq(search.text(), "aaaa")
  let expected : Array[@core.SearchHit] = []
  assert_eq(search.search("a", limit=0, context=40), expected)
}

///|
test "upstream search: negative context" {
  let runs : Array[@core.IndexRun] = [
    { a: 0, b: 0, ordinal: 0, separator: 0, text: "abcdefghijk", },
  ]
  let search = @core.TextSearch::new(runs, case_sensitive=false)
  assert_eq(search.text(), "abcdefghijk")
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 0, end: 1, }],
        text: "a",
        context: "cdefghij",
      },
    ]
    assert_eq(search.search("a", limit=1000, context=-2), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 3, end: 4, }],
        text: "d",
        context: "",
      },
    ]
    assert_eq(search.search("d", limit=1000, context=-2), expected)
  }
  let expected : Array[@core.SearchHit] = [
    {
      segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 10, end: 11, }],
      text: "k",
      context: "",
    },
  ]
  assert_eq(search.search("k", limit=1000, context=-2), expected)
}

///|
test "upstream search: real BDF page and layer index" {
  let runs : Array[@core.IndexRun] = [
    { a: 0, b: 0, ordinal: 0, separator: 2, text: "Document example", },
    { a: 0, b: 0, ordinal: 1, separator: 2, text: "Hello", },
    { a: 0, b: 0, ordinal: 2, separator: 1, text: "world", },
    { a: 0, b: 0, ordinal: 3, separator: 1, text: "Second line", },
    { a: 0, b: 0, ordinal: 4, separator: 2, text: "Jump to page", },
    { a: 0, b: 0, ordinal: 5, separator: 2, text: "Header", },
    { a: 0, b: 0, ordinal: 6, separator: 2, text: "Value", },
    { a: 0, b: 0, ordinal: 7, separator: 2, text: "Price", },
    { a: 0, b: 0, ordinal: 8, separator: 2, text: "42", },
    { a: 0, b: 0, ordinal: 9, separator: 2, text: "Far left", },
    { a: 0, b: 0, ordinal: 10, separator: 2, text: "Far right", },
    { a: 0, b: 0, ordinal: 11, separator: 2, text: "Chart", },
    { a: 0, b: 1, ordinal: 0, separator: 2, text: "Annotation", },
    { a: 0, b: 1, ordinal: 1, separator: 2, text: "Anno X", },
    { a: 0, b: 1, ordinal: 2, separator: 2, text: "Anno Y", },
    { a: 1, b: 0, ordinal: 0, separator: 2, text: "Second page", },
  ]
  let search = @core.TextSearch::new(runs, case_sensitive=false)
  assert_eq(
    search.text(),
    "document example\nhello world second line\njump to page\nheader\nvalue\nprice\n42\nfar left\nfar right\nchart\nannotation\nanno x\nanno y\nsecond page",
  )
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 0, a: 0, b: 0, ordinal: 0, start: 0, end: 16, }],
        text: "Document example",
        context: "document example ⏎ hello world second line ⏎ jump to page ⏎ he",
      },
    ]
    assert_eq(
      search.search("document example", limit=1000, context=40),
      expected,
    )
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [
          { run: 1, a: 0, b: 0, ordinal: 1, start: 0, end: 5, },
          { run: 2, a: 0, b: 0, ordinal: 2, start: 0, end: 5, },
        ],
        text: "Hello world",
        context: "document example ⏎ hello world second line ⏎ jump to page ⏎ header ⏎ value ⏎ p",
      },
    ]
    assert_eq(search.search("hello world", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 3, a: 0, b: 0, ordinal: 3, start: 0, end: 11, }],
        text: "Second line",
        context: "document example ⏎ hello world second line ⏎ jump to page ⏎ header ⏎ value ⏎ price ⏎ 42 ⏎ far ",
      },
    ]
    assert_eq(search.search("second line", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 12, a: 0, b: 1, ordinal: 0, start: 0, end: 10, }],
        text: "Annotation",
        context: "value ⏎ price ⏎ 42 ⏎ far left ⏎ far right ⏎ chart ⏎ annotation ⏎ anno x ⏎ anno y ⏎ second page",
      },
    ]
    assert_eq(search.search("annotation", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 15, a: 1, b: 0, ordinal: 0, start: 0, end: 11, }],
        text: "Second page",
        context: "ar right ⏎ chart ⏎ annotation ⏎ anno x ⏎ anno y ⏎ second page",
      },
    ]
    assert_eq(search.search("second page", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = []
    assert_eq(search.search("header value", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 11, a: 0, b: 0, ordinal: 11, start: 0, end: 5, }],
        text: "Chart",
        context: "eader ⏎ value ⏎ price ⏎ 42 ⏎ far left ⏎ far right ⏎ chart ⏎ annotation ⏎ anno x ⏎ anno y ⏎ second page",
      },
    ]
    assert_eq(search.search("chart", limit=1000, context=40), expected)
  }
  {
    let expected : Array[@core.SearchHit] = [
      {
        segments: [{ run: 7, a: 0, b: 0, ordinal: 7, start: 0, end: 5, }],
        text: "Price",
        context: "d second line ⏎ jump to page ⏎ header ⏎ value ⏎ price ⏎ 42 ⏎ far left ⏎ far right ⏎ chart ⏎ annotation ⏎ ",
      },
    ]
    assert_eq(search.search("price", limit=1000, context=40), expected)
  }
  let expected : Array[@core.SearchHit] = [
    {
      segments: [{ run: 8, a: 0, b: 0, ordinal: 8, start: 0, end: 2, }],
      text: "42",
      context: "nd line ⏎ jump to page ⏎ header ⏎ value ⏎ price ⏎ 42 ⏎ far left ⏎ far right ⏎ chart ⏎ annotation ⏎ ann",
    },
  ]
  assert_eq(search.search("42", limit=1000, context=40), expected)
}
