a\x07\x0f\x1f\x55\x3f\x7e\xf2\xf4\xd9\xf3\x17\x2f\x5f\xbd\x7e\xf3\xf6\xdd\xfb\x0f\x35\xb5\x1f\x3f\x7d\xfe\xf2\xb5\xee\xdb\xf7\x1f\x3f\xeb\x7f\xfd\xfe\xdf\xff\xff\x01"
  let expected_bytes : Array[Byte] = []
  for _ in 0..<1000 {
    for b in b"the quick brown fox jumps over the lazy dog " {
      expected_bytes.push(b)
    }
  }
  for _ in 0..<2 {
    for i in 0..<256 {
      expected_bytes.push(i.to_byte())
    }
  }
  let expected = Bytes::from_array(expected_bytes)
  assert_eq(inflate_bounded(compressed, expected.length()), expected)
  let oversized = try {
    ignore(inflate_bounded(compressed, expected.length() - 1))
    false
  } catch {
    _ => true
  }
  assert_true(oversized)
  for cut in 0..<compressed.length() {
    let truncated = try {
      ignore(inflate_bounded(compressed[:cut].to_owned(), expected.length()))
      false
    } catch {
      _ => true
    }
    assert_true(truncated)
  }
}

///|
test "inflate empty and trailing streams" {
  assert_eq(inflate_bounded(b"\x03\x00", 0), b"")
  assert_eq(inflate_bounded(b"\x03\x00\xff", 0), b"")
  let invalid = try {
    ignore(inflate_bounded(b"\x07", 1))
    false
  } catch {
    _ => true
  }
  assert_true(invalid)
}
