///|
test "inflate stored block" {
  let compressed : Bytes = b"\x01\x0d\x00\xf2\xff\x68\x65\x6c\x6c\x6f\x00\x64\x65\x66\x6c\x61\x74\x65"
  let expected : Bytes = b"\x68\x65\x6c\x6c\x6f\x00\x64\x65\x66\x6c\x61\x74\x65"
  assert_eq(inflate_bounded(compressed, expected.length()), expected)
  let oversized = try {
    ignore(inflate_bounded(compressed, expected.length() - 1))
    false
  } catch {
    _ => true
  }
  assert_true(oversized)
  for cut in 0..<compressed.length() {
    let truncated = try {
      ignore(inflate_bounded(compressed[:cut].to_owned(), expected.length()))
      false
    } catch {
      _ => true
    }
    assert_true(truncated)
  }
}

///|
test "inflate fixed block" {
  let compressed : Bytes = b"\x73\x72\x71\x53\x48\xcb\xac\x48\x4d\x51\x28\x2e\x29\x4a\x4d\xcc\x55\x70\x1a\x15\xa0\x54\x00\x00"
  let expected_bytes : Array[Byte] = []
  for _ in 0..<20 {
    for b in b"BDF fixed stream " {
      expected_bytes.push(b)
    }
  }
  let expected = Bytes::from_array(expected_bytes)
  assert_eq(inflate_bounded(compressed, expected.length()), expected)
  let oversized = try {
    ignore(inflate_bounded(compressed, expected.length() - 1))
    false
  } catch {
    _ => true
  }
  assert_true(oversized)
  for cut in 0..<compressed.length() {
    let truncated = try {
      ignore(inflate_bounded(compressed[:cut].to_owned(), expected.length()))
      false
    } catch {
      _ => true
    }
    assert_true(truncated)
  }
}

