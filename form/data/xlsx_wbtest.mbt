///|
test "form data reads an XLSX workbook" {
  let bytes = @base64.decode(""[:]) catch { _ => fail("base64") }
  let source : Source = { name: "", file_name: "data.xlsx", data: bytes }
  let data = load_data([source])
  let rows = array_of(data["People"])
  assert_eq(rows.length(), 2)
  let first = object_of(rows[0])
  assert_eq(first["name"], Json::string("Alice"))
  assert_eq(first["qty"], Json::number(2.0))
  assert_eq(first["ok"], Json::boolean(true))
  let second = object_of(rows[1])
  assert_eq(second["name"], Json::string("Bob"))
  assert_eq(second["ok"], Json::boolean(false))
  let named = load_data([{ ..source, name: "people" }])
  assert_eq(array_of(named["people"]).length(), 2)
}
