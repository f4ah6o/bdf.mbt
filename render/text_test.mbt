///|
// Object bytes generated by compat/text/generate.go using upstream v0.2.1.
test "extract text and links in upstream reading order" {
  let parent = @core.decode_object_resources(
    b"\x42\x4f\x42\x4a\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x90\x42\x00\x00\x23\x43\x0c\x00\x05\x48\x65\x6c\x6c\x6f\x05\x57\x6f\x72\x6c\x64\x06\x73\x65\x63\x6f\x6e\x64\x07\x77\x72\x61\x70\x70\x65\x64\x02\x6a\x61\x08\x6f\x75\x74\x6c\x69\x6e\x65\x64\x10\x64\x72\x61\x77\x6e\x20\x62\x79\x20\x61\x20\x63\x68\x69\x6c\x64\x14\x68\x74\x74\x70\x73\x3a\x2f\x2f\x65\x78\x61\x6d\x70\x6c\x65\x2e\x6f\x72\x67\x2f\x06\x68\x69\x64\x64\x65\x6e\x0a\x68\x69\x64\x64\x65\x6e\x2d\x61\x6c\x74\x06\x6f\x72\x70\x68\x61\x6e\x01\x00\x01\x05\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x20\x41\x00\x00\x20\x41\x00\x01\x01\x05\x73\x65\x72\x69\x66\x90\x01\x00\x00\x01\xcd\xf7\xbc\x4b\xf9\x40\xda\xfe\xf4\xe2\x34\x30\xdc\x1f\xdf\xc7\xbb\x01\x1a\x00\x00\x00\x20\x41\x71\x00\x00\x30\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xf0\x41\x30\x02\x00\x00\x0c\x42\x00\x00\x00\x00\x00\x00\xf0\x41\x71\x01\x00\x30\x03\x00\x00\x00\x00\x00\x00\x70\x41\x00\x00\x20\x42\x71\x05\x00\x30\x04\x00\x00\x00\x00\x00\x00\xf0\x41\x00\x00\x20\x42\x71\x0c\x05\x71\x04\x06\x24\x00\x00\x00\x00\xa0\x40\x00\x00\x34\x42\x01\x04\x00\x00\xc8\x42\x00\x00\xc8\x42\x50\x00\x02\x71\x04\x07\x51\x00\x00\x00\x48\x42\x00\x00\x16\x43\x01\x03\x00\x00\x00\x00\x00\x00\x80\x3f\x00\x00\x80\xbf\x00\x00\x00\x00\x00\x00\xa0\x41\x00\x00\xf0\x41\x70\x00\x00\x80\x3f\x00\x00\x00\x40\x00\x00\x40\x40\x00\x00\x80\x40\x08\x02\x54\x00\x00\x00\x00\x00\x00\x30\x09\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x20\x41\x71\x04\x0a\x55\x71\x04\x0b",
  )
  let child = @core.decode_object_resources(
    b"\x42\x4f\x42\x4a\x01\x00\x00\x00\x00\x00\x00\x40\x00\x00\x40\x40\x00\x00\xa0\x41\x00\x00\x20\x41\x01\x05\x63\x68\x69\x6c\x64\x00\x00\x00\x00\x00\x0e\x30\x00\x00\x00\xa0\x40\x00\x00\xe0\x40\x00\x00\x40\x41",
  )
  let content = @render.extract_text(parent, fn(hash) {
    if hash == "cdf7bc4bf940dafef4e23430dc1fdfc7" {
      Some(child)
    } else {
      None
    }
  })
  assert_eq(content.runs.length(), 8)
  guard content.runs[0].font is Some(font) else { fail("expected font") }
  assert_eq(
    (font.family, font.weight, content.runs[0].size),
    ("serif", 400, 10.0),
  )
  assert_true(content.runs[5].font is None)
  assert_eq(content.runs.map(fn(run) { run.text }), [
    "Hello", "World", "second", "wrapped", "outlined", "child", "drawn by a child",
    "orphan",
  ])
  assert_eq(content.runs.map(fn(run) { run.separator }), [
    2, 1, 1, 0, 1, 1, 1, 1,
  ])
  assert_eq(content.runs.map(fn(run) { run.ordinal }), [0, 1, 2, 3, 4, 5, 6, 7])
  assert_eq(
    (
      content.runs[4].x,
      content.runs[4].y,
      content.runs[4].alt_text,
      content.runs[4].lang,
    ),
    (5.0, 45.0, true, "ja"),
  )
  assert_eq(
    (content.runs[5].x, content.runs[5].y, content.runs[5].advance),
    (105.0, 107.0, 12.0),
  )
  assert_eq(content.runs[5].matrix, (1.0, 0.0, 0.0, 1.0, 100.0, 100.0))
  assert_eq(
    (
      content.runs[6].x,
      content.runs[6].y,
      content.runs[6].advance,
      content.runs[6].alt_text,
    ),
    (52.0, 150.0, 20.0, true),
  )
  assert_eq(
    (content.runs[7].x, content.runs[7].y, content.runs[7].alt_text),
    (0.0, 0.0, true),
  )
  assert_eq(content.links.length(), 1)
  let link = content.links[0]
  assert_eq(
    (link.x, link.y, link.width, link.height, link.after),
    (14.0, 31.0, 4.0, 3.0, 6),
  )
  assert_eq(link.url, "https://example.org/")
  assert_eq(
    @render.join_text(content.runs),
    "Hello World secondwrapped outlined child drawn by a child orphan",
  )
  let view : @core.View = {
    id: "v",
    kind: "fixed",
    title: "",
    text_index: None,
    pages: [
      {
        width: 100.0,
        height: 100.0,
        layers: [
          { role: "body", object: "parent", },
          { role: "annotation", object: "child", },
        ],
      },
      {
        width: 100.0,
        height: 100.0,
        layers: [{ role: "body", object: "child", }],
      },
    ],
  }
  let index = @render.build_page_text_index(view, fn(hash) {
    if hash == "parent" {
      Some(parent)
    } else if hash == "child" || hash == "cdf7bc4bf940dafef4e23430dc1fdfc7" {
      Some(child)
    } else {
      None
    }
  })
  assert_eq(index.length(), 10)
  assert_eq(index[0].separator, 2)
  assert_eq(
    (index[8].a, index[8].b, index[8].ordinal, index[8].separator),
    (0, 1, 0, 2),
  )
  assert_eq(
    (index[9].a, index[9].b, index[9].ordinal, index[9].separator),
    (1, 0, 0, 2),
  )
  assert_eq(
    @core.index_plain_text(index),
    "Hello World secondwrapped outlined child drawn by a child orphan\nchild\nchild",
  )
  let indexed_view = { ..view, text_index: Some("index"), }
  let stored_index = @render.page_text_index(
    indexed_view,
    fn(hash) {
      assert_eq(hash, "index")
      b"BTXT\x01\x00\x01\x01\x02\x03\x02\x03abc"
    },
    fn(_) { fail("stored index must not extract objects") },
  )
  assert_eq(
    (
      stored_index[0].a,
      stored_index[0].b,
      stored_index[0].ordinal,
      stored_index[0].text,
    ),
    (1, 2, 3, "abc"),
  )
  let fallback_index = @render.page_text_index(
    view,
    fn(_) { fail("fallback must not read an index part") },
    fn(hash) { if hash == "parent" { Some(parent) } else { Some(child) } },
  )
  assert_eq(fallback_index, index)
  let transformed = @render.extract_text(
    parent,
    fn(hash) {
      if hash == "cdf7bc4bf940dafef4e23430dc1fdfc7" {
        Some(child)
      } else {
        None
      }
    },
    matrix=(2.0, 0.0, 0.0, 3.0, 4.0, 5.0),
  )
  assert_eq((transformed.runs[5].x, transformed.runs[5].y), (214.0, 326.0))
  assert_eq(
    (
      transformed.links[0].x,
      transformed.links[0].y,
      transformed.links[0].width,
      transformed.links[0].height,
    ),
    (32.0, 98.0, 8.0, 9.0),
  )
}

///|
test "recursive child references are bounded" {
  let hash = "0123456789abcdef0123456789abcdef"
  let object : @core.ObjectResources = {
    object: {
      bbox: (0.0, 0.0, 0.0, 0.0),
      strings: [],
      images: [],
      objects: [hash],
      ops: b"\x50\x00",
    },
    paths: [],
    paints: [],
    fonts: [],
  }
  let rejected = try {
    ignore(@render.extract_text(object, fn(_) { Some(object) }))
    false
  } catch {
    _ => true
  }
  assert_true(rejected)
}

///|
test "unresolved child alternative text remains selectable" {
  let hash = "0123456789abcdef0123456789abcdef"
  let object : @core.ObjectResources = {
    object: {
      bbox: (0.0, 0.0, 0.0, 0.0),
      strings: ["description"],
      images: [],
      objects: [hash],
      ops: b"\x71\x04\x00\x51\x00\x00\x00\xa0\x40\x00\x00\xc0\x40",
    },
    paths: [],
    paints: [],
    fonts: [],
  }
  let content = @render.extract_text(object, fn(_) { None })
  assert_eq(content.runs.length(), 1)
  assert_eq(
    (
      content.runs[0].text,
      content.runs[0].x,
      content.runs[0].y,
      content.runs[0].advance,
      content.runs[0].alt_text,
    ),
    ("description", 5.0, 6.0, 0.0, true),
  )
}
