///|
fn baseline_test_font() -> @core.Font {
  { hash: None, family: "serif", weight: 400, style: 0 }
}

///|
fn baseline_legacy_signature(content : TextContent) -> Array[(String, Double, Double, Double, Double, Int32, Int32)] {
  content.runs.map(r => (r.text, r.x, r.y, r.advance, r.size, r.align, r.separator))
}

///|
test "simple baseline metadata keeps legacy run values and save restore" {
  let obj = @core.ObjectBuilder::new()
  let font = obj.add_font(baseline_test_font())
  obj.font(font, 20.0F)
  obj.fill_text("default", 0.0F, 10.0F, 3.0F)
  obj.text_style(2, 1, 0, 0.0F)
  obj.fill_text("top", 0.0F, 20.0F, 3.0F)
  obj.save()
  obj.text_style(0, 2, 0, 0.0F)
  obj.fill_text("middle", 0.0F, 30.0F, 3.0F)
  obj.restore()
  obj.fill_text("top again", 0.0F, 40.0F, 3.0F)
  let source = @core.decode_object_resources(obj.encode())
  let legacy = extract_text(source, _ => None)
  let (detail, baselines) = extract_text_with_baselines(source, _ => None)
  assert_eq(baselines, [0, 1, 0, 1])
  assert_eq(baseline_legacy_signature(detail), baseline_legacy_signature(legacy))
  assert_eq(join_text(detail.runs), join_text(legacy.runs))
  let (_, external_transform) = extract_text_with_baselines(source, _ => None, matrix=(1.0, 0.0, 0.0, 2.0, 0.0, 0.0))
  assert_eq(external_transform, [0, 0, 0, 0])
}

///|
test "complex objects, figures, no-font and alt keep the old coordinates" {
  let child = @core.ObjectBuilder::new()
  child.fill_text("child", 0.0F, 0.0F, 10.0F)
  let child_obj = @core.decode_object_resources(child.encode())
  let parent = @core.ObjectBuilder::new()
  let font = parent.add_font(baseline_test_font())
  parent.font(font, 20.0F)
  parent.text_style(0, 1, 0, 0.0F)
  parent.fill_text("parent", 0.0F, 0.0F, 10.0F)
  let child_ref = parent.add_object("00000000000000000000000000000000", (0.0F, 0.0F, 10.0F, 10.0F))
  parent.use_object(child_ref)
  parent.fill_text("after", 10.0F, 8.0F, 10.0F)
  let source = @core.decode_object_resources(parent.encode())
  let legacy = extract_text(source, _ => Some(child_obj))
  let (detail, baselines) = extract_text_with_baselines(source, _ => Some(child_obj))
  assert_eq(baselines, [0, 0, 0])
  assert_eq(baseline_legacy_signature(detail), baseline_legacy_signature(legacy))
  assert_eq(join_text(detail.runs), join_text(legacy.runs))
  let group = @core.ObjectBuilder::new()
  let group_font = group.add_font(baseline_test_font())
  group.font(group_font, 20.0F)
  group.text_style(0, 1, 0, 0.0F)
  group.fill_text("before", 0.0F, 1.0F, 10.0F)
  group.group_begin(1.0F, 0, 0.0F, 0.0F, 100.0F, 100.0F)
  group.fill_text("inside", 0.0F, 2.0F, 10.0F)
  group.group_end()
  group.fill_text("after", 0.0F, 3.0F, 10.0F)
  let (_, group_baselines) = extract_text_with_baselines(@core.decode_object_resources(group.encode()), _ => None)
  assert_eq(group_baselines, [0, 0, 0])
  let mask = @core.ObjectBuilder::new()
  let mask_font = mask.add_font(baseline_test_font())
  mask.font(mask_font, 20.0F)
  mask.text_style(0, 1, 0, 0.0F)
  mask.fill_text("before", 0.0F, 1.0F, 10.0F)
  mask.mask_begin(0, 0U, b"")
  mask.fill_text("hidden", 0.0F, 2.0F, 10.0F)
  mask.mask_end()
  mask.fill_text("after", 0.0F, 3.0F, 10.0F)
  let (_, mask_baselines) = extract_text_with_baselines(@core.decode_object_resources(mask.encode()), _ => None)
  assert_eq(mask_baselines, [0, 0])
  let fig = @core.ObjectBuilder::new()
  let fig_font = fig.add_font(baseline_test_font())
  fig.font(fig_font, 20.0F)
  fig.text_style(0, 1, 0, 0.0F)
  fig.fill_text("before figure", 0.0F, 1.0F, 10.0F)
  fig.mark(10, "diagram")
  fig.fill_text("in figure", 0.0F, 2.0F, 10.0F)
  fig.mark(11, "")
  let (_, figure_baselines) = extract_text_with_baselines(@core.decode_object_resources(fig.encode()), _ => None)
  assert_eq(figure_baselines, [0, 0])
  let transformed = @core.ObjectBuilder::new()
  let transform_font = transformed.add_font(baseline_test_font())
  transformed.font(transform_font, 20.0F)
  transformed.text_style(0, 1, 0, 0.0F)
  transformed.fill_text("before", 0.0F, 1.0F, 10.0F)
  transformed.scale(1.0F, 2.0F)
  transformed.fill_text("scaled", 0.0F, 2.0F, 10.0F)
  let (_, transformed_baselines) = extract_text_with_baselines(@core.decode_object_resources(transformed.encode()), _ => None)
  assert_eq(transformed_baselines, [0, 0])
  let nofont = @core.ObjectBuilder::new()
  nofont.text_style(0, 1, 0, 0.0F)
  nofont.fill_text("no font", 0.0F, 2.0F, 10.0F)
  let (_, nofont_baselines) = extract_text_with_baselines(@core.decode_object_resources(nofont.encode()), _ => None)
  assert_eq(nofont_baselines, [0])
  let alt = @core.ObjectBuilder::new()
  let alt_font = alt.add_font(baseline_test_font())
  alt.font(alt_font, 20.0F)
  alt.text_style(0, 1, 0, 0.0F)
  alt.mark(4, "alt text")
  alt.fill_text("rendered", 0.0F, 2.0F, 10.0F)
  let (_, alt_baselines) = extract_text_with_baselines(@core.decode_object_resources(alt.encode()), _ => None)
  assert_eq(alt_baselines, [0])
}

///|
test "property: supported baseline is bounded and legacy extraction is identical" {
  @quickcheck.check((baseline : Byte) => {
    let object = @core.ObjectBuilder::new()
    let font = object.add_font(baseline_test_font())
    object.font(font, 20.0F)
    object.text_style(0, baseline, 0, 0.0F)
    object.fill_text("x", 3.0F, 7.0F, 8.0F)
    let source = @core.decode_object_resources(object.encode())
    let (detail, baselines) = extract_text_with_baselines(source, _ => None)
    let legacy = extract_text(source, _ => None)
    let expected = if baseline.to_int() == 1 { 1 } else { 0 }
    baselines == [expected] && baseline_legacy_signature(detail) == baseline_legacy_signature(legacy) && join_text(detail.runs) == join_text(legacy.runs)
  })
}
