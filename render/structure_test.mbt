///|
test "parse A1 cell references" {
  assert_eq(
    @render.parse_cell_ref("A1"),
    Some({ row: 0, col: 0, rows: 1, cols: 1, scope: None, }),
  )
  assert_eq(
    @render.parse_cell_ref(" b12 row "),
    Some({ row: 11, col: 1, rows: 1, cols: 1, scope: Some("row"), }),
  )
  assert_eq(
    @render.parse_cell_ref("B2:C3 col"),
    Some({ row: 1, col: 1, rows: 2, cols: 2, scope: Some("col"), }),
  )
  assert_eq(
    @render.parse_cell_ref("AA1"),
    Some({ row: 0, col: 26, rows: 1, cols: 1, scope: None, }),
  )
  assert_eq(
    @render.parse_cell_ref("\u{feff}Z10:A1\tcol\n"),
    Some({ row: 9, col: 25, rows: 1, cols: 1, scope: Some("col"), }),
  )
  assert_true(@render.parse_cell_ref("A1\u{85}") is None)
  for invalid in ["", "12", "A0", "A1 top", "A1col", "A1 :B2"] {
    assert_true(@render.parse_cell_ref(invalid) is None)
  }
}
