///|
test "DICT offsets clamp without wrapping valid large offsets" {
  assert_eq(operand(1500000000.0), 1500000000)
  assert_eq(operand(1.0e300), -2147483647)
  assert_eq(operand(-1.0e300), -2147483647)
  assert_eq(operand(1.0e15), 2147483647)
}
