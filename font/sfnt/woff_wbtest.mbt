///|
test "WOFF rejects a short directory" {
  let data = b"\x77\x4f\x46\x46\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
  match
    (try {
      ignore(decode_woff(data))
      ""
    } catch {
      InvalidFont(message) => message
      _ => "other"
    }) {
    "WOFF table directory truncated" => ()
    message => fail(message)
  }
}
