test "glyph names post-duplicates" {
  let data : Bytes = b"\x00\x01\x00\x00\x00\x02\x00\x20\x00\x01\x00\x00\x6d\x61\x78\x70\x00\x06\x00\x00\x00\x00\x00\x2c\x00\x00\x00\x06\x70\x6f\x73\x74\xe5\xfe\x7e\x52\x00\x00\x00\x34\x00\x00\x00\x39\x00\x01\x00\x00\x00\x05\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x24\x00\x24\x01\x02\x01\x03\x01\x02\x01\x04\x01\x58\x01\x58\x06\x63\x75\x73\x74\x6f\x6d\x00\x00\x00"
  let font = parse(data)
  assert_eq(font.glyph_names(), ["A", "", "X", "", ""])
}

