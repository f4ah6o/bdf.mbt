///|
test "GDEF classes and mark sets" {
  let data : Bytes = b"\x00\x01\x00\x02\x00\x0e\x00\x00\x00\x00\x00\x1c\x00\x2c\x00\x01\x00\x0a\x00\x04\x00\x01\x00\x00\x00\x02\x00\x03\x00\x02\x00\x02\x00\x0a\x00\x0c\x00\x03\x00\x0c\x00\x0e\x00\x02\x00\x01\x00\x02\x00\x00\x00\x0c\x00\x00\x00\x16\x00\x01\x00\x03\x00\x04\x00\x05\x00\x06\x00\x02\x00\x01\x00\x14\x00\x16\x00\x00"
  let g = parse_gdef(data[:]).unwrap()
  assert_eq(g.classes.get(10), Some(1))
  assert_eq(g.classes.get(11), None)
  assert_eq(g.classes.get(12), Some(2))
  assert_eq(g.mark_attach.get(12), Some(2))
  assert_eq(g.mark_sets, [[4, 5, 6], [20, 21, 22]])
}
