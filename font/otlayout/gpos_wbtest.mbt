///|
test "GPOS pair counts and extension lookups" {
  let data : Bytes = b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x0a\x00\x02\x00\x06\x00\x5c\x00\x02\x00\x00\x00\x02\x00\x0a\x00\x26\x00\x01\x00\x0c\x00\x04\x00\x00\x00\x01\x00\x12\x00\x01\x00\x01\x00\x05\x00\x02\x00\x0a\xff\xdc\x00\x0b\x00\x00\x00\x02\x00\x18\x00\x04\x00\x00\x00\x1e\x00\x26\x00\x02\x00\x02\x00\x00\x00\x00\x00\x00\xff\xdc\x00\x01\x00\x01\x00\x05\x00\x01\x00\x05\x00\x01\x00\x01\x00\x01\x00\x0a\x00\x02\x00\x01\x00\x01\x00\x09\x00\x00\x00\x01\x00\x08\x00\x01\x00\x02\x00\x00\x00\x08\x00\x01\x00\x0c\x00\x04\x00\x00\x00\x01\x00\x12\x00\x01\x00\x01\x00\x05\x00\x02\x00\x0a\xff\xdc\x00\x0b\x00\x00"
  let gpos = parse_gpos(data[:]).unwrap()
  assert_eq(gpos.pair_count(0), 3L)
  assert_eq(gpos.pair_count(0), 3L)
  assert_eq(gpos.pair_count(1), 1L)
  assert_eq(gpos.pair_count(-1), 0L)
  assert_false(gpos.truncated())
}
